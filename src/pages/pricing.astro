---
import Layout from '../layouts/Layout.astro';
import { PLANS } from '../lib/plans';
import { getUserById } from '../lib/db';
import { env } from 'cloudflare:workers';

export const prerender = false;

const user = Astro.locals.user ?? null;
let currentPlan = 'free';
if (user && env?.DB) {
  const dbUser = await getUserById(env.DB, user.id);
  currentPlan = dbUser?.plan ?? 'free';
}

const plans = [PLANS.free, PLANS.pro, PLANS.master];
---
<Layout title="Pricing">

<header class="top-nav">
  <div class="top-nav-inner">
    <a href="/" class="logo">
      <span class="logo-dot"></span>
      ImgHost
    </a>
    <nav class="header-nav">
      {user ? (
        <>
          <a href="/dashboard" class="btn btn-ghost">Dashboard</a>
          <div class="user-chip">
            <div class="avatar">{user.email.charAt(0).toUpperCase()}</div>
            <span class="user-email">{user.email}</span>
          </div>
        </>
      ) : (
        <>
          <a href="/login" class="btn btn-ghost">Sign in</a>
          <a href="/signup" class="btn btn-primary">Get started free</a>
        </>
      )}
    </nav>
  </div>
</header>

<main class="pricing-main">
  <div class="pricing-head">
    <span class="eyebrow-tight">Pricing</span>
    <h1 class="pricing-title">Simple.<br/>Transparent.</h1>
    <p class="pricing-sub">Upgrade any time. Pay once for the capacity you need. No subscriptions, no surprises.</p>
  </div>

  <div class="pricing-grid">
    {plans.map((plan) => (
      <div class={`pricing-card ${plan.id === 'master' ? 'pricing-card-featured' : ''} ${currentPlan === plan.id ? 'pricing-card-current' : ''}`} data-plan={plan.id}>
        {plan.id === 'master' && <div class="pricing-badge">Most value</div>}
        {currentPlan === plan.id && <div class="pricing-badge pricing-badge-current">Your plan</div>}
        <div class="pricing-name">{plan.name}</div>
        <div class="pricing-price">
          {plan.priceInr === 0
            ? <><span class="price-amount">Free</span></>
            : <><span class="price-currency">₹</span><span class="price-amount">{plan.priceInr}</span><span class="price-period">one-time</span></>
          }
        </div>
        <ul class="pricing-features">
          {plan.features.map((f) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        {plan.priceInr === 0 ? (
          <button class="btn btn-ghost pricing-btn" disabled>{currentPlan === plan.id ? 'Current plan' : 'Default plan'}</button>
        ) : currentPlan === plan.id ? (
          <button class="btn btn-ghost pricing-btn" disabled>Active</button>
        ) : (
          <button class="btn btn-primary pricing-btn buy-btn" data-plan={plan.id} data-amount={plan.priceInr} data-name={plan.name}>
            Upgrade to {plan.name}
          </button>
        )}
      </div>
    ))}
  </div>

  <p class="pricing-footnote">
    Payments are securely processed by <a href="https://www.cashfree.com" target="_blank" rel="noopener">Cashfree Payments</a>.
    You must be signed in to purchase a plan.
  </p>
</main>

<!-- ═══ Phone collection modal (Cashfree requires a valid phone number) ═══ -->
<div class="modal" id="phone-modal" hidden>
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="phone-modal-title">
    <div class="modal-head">
      <h3 id="phone-modal-title" class="modal-title">Confirm your purchase</h3>
      <button class="modal-close" data-close-modal aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal-body">
      <p class="modal-desc">You're upgrading to <strong id="phone-modal-plan">—</strong> for <strong id="phone-modal-amount">—</strong>.</p>
      <label class="field">
        <span class="field-label">Phone number (10 digits)</span>
        <input type="tel" id="phone-input" class="field-input" placeholder="9999999999" inputmode="numeric" maxlength="10" pattern="[0-9]{10}" />
      </label>
      <div id="phone-error" class="alert" hidden></div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" data-close-modal>Cancel</button>
      <button class="btn btn-primary" id="pay-btn">
        <span id="pay-btn-label">Pay with Cashfree</span>
      </button>
    </div>
  </div>
</div>

</Layout>

<!-- Cashfree JS SDK v3 -->
<script src="https://sdk.cashfree.com/js/v3/cashfree.js" is:inline></script>

<script define:vars={{ isLoggedIn: !!user }}>
(function () {
  const modal     = document.getElementById('phone-modal');
  const phoneEl   = document.getElementById('phone-input');
  const planEl    = document.getElementById('phone-modal-plan');
  const amountEl  = document.getElementById('phone-modal-amount');
  const payBtn    = document.getElementById('pay-btn');
  const payLabel  = document.getElementById('pay-btn-label');
  const errEl     = document.getElementById('phone-error');

  let currentPlan = null;

  function openModal(plan, amount, name) {
    if (!isLoggedIn) {
      window.location.href = '/login?next=/pricing';
      return;
    }
    currentPlan = plan;
    planEl.textContent = name + ' plan';
    amountEl.textContent = '₹' + amount;
    errEl.hidden = true;
    errEl.textContent = '';
    phoneEl.value = '';
    payLabel.textContent = 'Pay with Cashfree';
    payBtn.disabled = false;
    modal.hidden = false;
    setTimeout(() => phoneEl.focus(), 50);
  }

  function closeModal() { modal.hidden = true; }

  function showError(msg) {
    errEl.textContent = msg;
    errEl.hidden = false;
  }

  document.querySelectorAll('.buy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      openModal(btn.dataset.plan, btn.dataset.amount, btn.dataset.name);
    });
  });

  document.querySelectorAll('[data-close-modal]').forEach((el) => {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });

  payBtn.addEventListener('click', async () => {
    const phone = (phoneEl.value || '').replace(/\D/g, '');
    if (!/^[0-9]{10}$/.test(phone)) {
      showError('Please enter a valid 10-digit phone number.');
      return;
    }
    errEl.hidden = true;
    payBtn.disabled = true;
    payLabel.textContent = 'Creating order…';

    let data;
    try {
      const res = await fetch('/api/payments/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ plan: currentPlan, phone }),
      });
      data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Order creation failed');
    } catch (err) {
      payBtn.disabled = false;
      payLabel.textContent = 'Pay with Cashfree';
      showError(err.message || 'Something went wrong. Please try again.');
      return;
    }

    if (typeof window.Cashfree !== 'function') {
      showError('Cashfree SDK failed to load. Please refresh and try again.');
      payBtn.disabled = false;
      payLabel.textContent = 'Pay with Cashfree';
      return;
    }

    const cashfree = window.Cashfree({ mode: data.environment === 'production' ? 'production' : 'sandbox' });
    payLabel.textContent = 'Redirecting…';
    cashfree.checkout({
      paymentSessionId: data.paymentSessionId,
      redirectTarget: '_self',
    });
  });
})();
</script>

<style>
  /* ─── Top nav ─────────────────────────────────────────────── */
  .top-nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(9,9,9,.72); backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--border);
  }
  .top-nav-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 28px; height: 64px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .logo {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-display); font-weight: 600; font-size: 16px;
    letter-spacing: -0.4px; color: var(--text);
  }
  .logo-dot {
    width: 14px; height: 14px; border-radius: 50%;
    background: conic-gradient(from 210deg, var(--g-violet), var(--g-magenta), var(--g-orange), var(--g-violet));
    box-shadow: 0 0 20px rgba(212,77,240,.35);
  }
  .header-nav { display: flex; align-items: center; gap: 10px; }
  .user-chip {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 12px 6px 6px; background: var(--surface);
    border: 1px solid var(--border); border-radius: 100px;
  }
  .avatar {
    width: 26px; height: 26px; border-radius: 50%;
    background: linear-gradient(135deg, var(--g-violet), var(--g-magenta));
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 12px; font-weight: 600;
  }
  .user-email { font-size: 13px; color: var(--text-muted); letter-spacing: -0.13px; }
  @media (max-width: 600px) { .user-email { display: none; } }

  /* ─── Hero ────────────────────────────────────────────────── */
  .pricing-main {
    position: relative;
    padding: 80px 28px 96px;
    max-width: 1200px; margin: 0 auto;
  }
  .pricing-main::before {
    content: ''; position: absolute; pointer-events: none;
    top: 0; left: 50%; transform: translateX(-50%);
    width: 900px; height: 500px; border-radius: 50%;
    background: radial-gradient(circle, rgba(106,76,245,.18), transparent 60%);
    filter: blur(100px); z-index: 0;
  }
  .pricing-head {
    position: relative; z-index: 1;
    text-align: center; margin-bottom: 64px;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
  }
  .eyebrow-tight {
    text-transform: uppercase; letter-spacing: .12em;
    font-size: 12px; color: var(--text-muted); font-weight: 500;
  }
  .pricing-title {
    font-family: var(--font-display);
    font-size: clamp(44px, 7vw, 85px); font-weight: 500;
    letter-spacing: -0.05em; line-height: 0.95;
    color: var(--text);
  }
  .pricing-sub {
    font-size: 18px; color: var(--text-muted);
    letter-spacing: -0.18px; line-height: 1.4; max-width: 520px;
  }

  .pricing-grid {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
  }
  @media (max-width: 900px) { .pricing-grid { grid-template-columns: 1fr; } }

  .pricing-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px 28px;
    display: flex; flex-direction: column;
    transition: border-color .18s ease, background .18s ease, transform .18s ease;
  }
  .pricing-card:hover {
    border-color: var(--border-strong);
    background: var(--surface-2);
    transform: translateY(-2px);
  }
  /* Featured = Master: one surface step up (Framer spec: lift, not chromatic outline) */
  .pricing-card-featured {
    background: var(--surface-2);
    border-color: var(--border-strong);
  }
  .pricing-card-current { border-color: rgba(34,197,94,.4); }

  .pricing-badge {
    position: absolute; top: -12px; left: 24px;
    background: #fff; color: #000;
    padding: 6px 12px; border-radius: 100px;
    font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase;
  }
  .pricing-badge-current {
    background: rgba(34,197,94,.15); color: var(--success);
    border: 1px solid rgba(34,197,94,.35);
    left: auto; right: 24px;
  }

  .pricing-name {
    font-size: 13px; font-weight: 500; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: .12em;
  }
  .pricing-price {
    margin: 16px 0 24px; display: flex; align-items: baseline; gap: 6px;
    font-family: var(--font-display);
  }
  .price-currency { font-size: 24px; font-weight: 500; color: var(--text); letter-spacing: -0.02em; }
  .price-amount {
    font-size: 56px; font-weight: 500; color: var(--text);
    letter-spacing: -0.04em; line-height: 1;
  }
  .price-period {
    font-family: var(--font-body);
    font-size: 13px; color: var(--text-muted); margin-left: 6px;
    font-weight: 500; letter-spacing: -0.13px;
  }

  .pricing-features {
    list-style: none; display: flex; flex-direction: column; gap: 12px;
    flex: 1; margin-bottom: 24px;
  }
  .pricing-features li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 14.5px; color: var(--text); letter-spacing: -0.14px; line-height: 1.4;
  }
  .pricing-features svg {
    flex: none; color: var(--success); margin-top: 3px;
  }

  .pricing-btn {
    width: 100%; justify-content: center;
    padding: 13px 18px; font-size: 14.5px;
  }

  .pricing-footnote {
    text-align: center; margin-top: 48px;
    font-size: 13px; color: var(--text-muted); letter-spacing: -0.13px;
  }
  .pricing-footnote a { color: var(--accent-blue); font-weight: 500; }
  .pricing-footnote a:hover { text-decoration: underline; }

  /* ─── Modal ──────────────────────────────────────────────── */
  .modal { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 100; }
  .modal-backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,.65); backdrop-filter: blur(6px);
  }
  .modal-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 0; width: min(460px, 92vw);
    box-shadow: var(--shadow-lg);
    animation: modal-in .18s ease-out;
  }
  @keyframes modal-in { from { transform: translateY(6px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  .modal-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px 24px 8px;
  }
  .modal-title {
    font-family: var(--font-display);
    font-size: 20px; font-weight: 500; letter-spacing: -0.03em; color: var(--text);
  }
  .modal-close {
    background: transparent; border: none; color: var(--text-muted);
    cursor: pointer; padding: 6px; border-radius: 100px; display: flex;
  }
  .modal-close:hover { background: var(--surface-2); color: var(--text); }
  .modal-body { padding: 8px 24px 20px; }
  .modal-desc {
    font-size: 14.5px; color: var(--text-muted);
    letter-spacing: -0.14px; margin-bottom: 16px; line-height: 1.4;
  }
  .modal-desc strong { color: var(--text); font-weight: 500; }
  .modal-foot {
    display: flex; gap: 10px; justify-content: flex-end;
    padding: 16px 24px 22px; border-top: 1px solid var(--border);
  }

  .field { display: block; }
  .field-label {
    display: block; font-size: 12px; font-weight: 500;
    color: var(--text-muted); margin-bottom: 8px;
    letter-spacing: .08em; text-transform: uppercase;
  }
  .field-input {
    width: 100%; padding: 11px 14px; font-size: 15px;
    border: 1px solid var(--border); border-radius: 10px;
    background: var(--canvas); color: var(--text);
    font-family: inherit;
  }
  .field-input:focus {
    outline: none;
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px var(--primary-glow);
  }
</style>
