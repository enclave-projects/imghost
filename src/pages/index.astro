---
import Layout from '../layouts/Layout.astro';
export const prerender = false;
---
<Layout title="Secure Image Hosting on the Edge">

  <div class="landing">
  <!-- ═══ NAV ═══════════════════════════════════════════════════════════════ -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="logo">
        <span class="logo-dot"></span>
        ImgHost
      </a>
      <div class="nav-center">
        <a href="#features">Features</a>
        <a href="#security">Security</a>
        <a href="/pricing">Pricing</a>
        <a href="#faq">FAQ</a>
      </div>
      <div class="nav-links">
        <a href="/login" class="pill pill-secondary">Sign in</a>
        <a href="/signup" class="pill pill-primary">Get started free</a>
      </div>
    </div>
  </nav>

  <!-- ═══ HERO ══════════════════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow">
        <span class="eyebrow-dot"></span>
        Built on Cloudflare · Zero egress · Secure by default
      </span>
      <h1 class="display">
        Host images<br/>
        at the edge.<br/>
        <span class="ink-muted">Share them<br/>anywhere.</span>
      </h1>
      <p class="lead">
        A confident, secure image host for builders. Uploads land in R2, sessions ride on HTTP-only JWTs, and every byte is delivered from 300+ Cloudflare locations in under 50&nbsp;ms.
      </p>
      <div class="cta-row">
        <a href="/signup" class="pill pill-primary pill-lg">Get started free</a>
        <a href="/pricing" class="pill pill-secondary pill-lg">See pricing</a>
      </div>
      <div class="trust-row">
        <span>No credit card</span><span class="sep">·</span>
        <span>PBKDF2 passwords</span><span class="sep">·</span>
        <span>Private by default</span>
      </div>

      <!-- Product mockup tile -->
      <div class="mockup">
        <div class="mockup-chrome">
          <div class="chrome-dots"><i></i><i></i><i></i></div>
          <div class="chrome-url">imghost.pranjal-ai-arena.workers.dev/dashboard</div>
        </div>
        <div class="mockup-body">
          <div class="mockup-upload">
            <div class="mockup-thumb"></div>
            <div style="flex:1; min-width:0;">
              <div class="mockup-file">photo-sunset.jpg</div>
              <div class="mockup-bar"><div class="mockup-bar-fill"></div></div>
              <div class="mockup-meta">2.4 MB · Uploading 78%</div>
            </div>
            <div class="mockup-status">Encrypted</div>
          </div>
          <div class="mockup-url">
            <span class="mockup-url-path">https://imghost.../u/abc123.jpg</span>
            <span class="mockup-copy">Copy link</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SPOTLIGHT GRID ═════════════════════════════════════════════════════ -->
  <section class="spotlight-section">
    <div class="container">
      <div class="spotlight-grid">
        <div class="spot spot-violet">
          <div class="spot-tag">Global edge</div>
          <h3 class="spot-title">300+ locations.<br/>Sub-50&nbsp;ms delivery.</h3>
          <p class="spot-body">Every image ships from the Cloudflare PoP closest to your visitor — no origin round-trips, no cold paths.</p>
        </div>
        <div class="spot spot-magenta">
          <div class="spot-tag">Zero egress</div>
          <h3 class="spot-title">Serve unlimited bandwidth.<br/>Pay nothing for it.</h3>
          <p class="spot-body">R2 has no egress fees. Embed your images everywhere without watching the bill climb.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FEATURES ══════════════════════════════════════════════════════════ -->
  <section class="features" id="features">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow eyebrow-tight">Why ImgHost</span>
        <h2 class="display-md">Everything you need.<br/>Nothing you don't.</h2>
      </div>

      <div class="feat-grid">
        <div class="feat-card">
          <div class="feat-glyph">01</div>
          <h3>Edge-native delivery</h3>
          <p>Workers + R2 + D1. Your images and metadata never leave the Cloudflare perimeter.</p>
        </div>
        <div class="feat-card">
          <div class="feat-glyph">02</div>
          <h3>Private by default</h3>
          <p>Images are scoped to your account. HTTP-only JWT sessions. PBKDF2 (100k) password hashing.</p>
        </div>
        <div class="feat-card">
          <div class="feat-glyph">03</div>
          <h3>Validated uploads</h3>
          <p>JPEG, PNG, GIF, WebP, AVIF, SVG, BMP — verified by magic bytes, not just extension.</p>
        </div>
        <div class="feat-card">
          <div class="feat-glyph">04</div>
          <h3>Folders &amp; bulk ops</h3>
          <p>Organize into folders, multi-select, bulk delete and move. Storage stays clean, always.</p>
        </div>
        <div class="feat-card">
          <div class="feat-glyph">05</div>
          <h3>Permanent URLs</h3>
          <p>Every upload gets a stable, CDN-backed link. Copy it once, embed it forever.</p>
        </div>
        <div class="feat-card">
          <div class="feat-glyph">06</div>
          <h3>Plan-aware limits</h3>
          <p>Free, Pro, Master. Upgrade via Cashfree — storage, rate limits, and upload windows scale with you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SECURITY BAND ══════════════════════════════════════════════════════ -->
  <section class="security" id="security">
    <div class="container security-grid">
      <div class="security-copy">
        <span class="eyebrow eyebrow-tight">Secure by design</span>
        <h2 class="display-md">Your images.<br/>Your account.<br/>No one else's.</h2>
        <p class="lead-sm">Hardened from storage to session. We don't guess at security — we build with primitives that Cloudflare already proves at scale.</p>
        <ul class="security-list">
          <li><span class="check"></span>HTTP-only, SameSite session cookies signed with HS256</li>
          <li><span class="check"></span>PBKDF2-SHA256 password hashing (100,000 iterations)</li>
          <li><span class="check"></span>User-scoped queries — every row filtered by <code>user_id</code></li>
          <li><span class="check"></span>Upload rate limits and magic-byte validation</li>
          <li><span class="check"></span>Cashfree webhook signatures verified via Web Crypto</li>
        </ul>
      </div>
      <div class="spot spot-orange security-spot">
        <div class="spot-tag">Built on Cloudflare</div>
        <h3 class="spot-title">Workers.<br/>R2.<br/>D1.</h3>
        <p class="spot-body">One perimeter, one identity, one control plane. No third-party storage, no surprise egress, no mystery regions.</p>
      </div>
    </div>
  </section>

  <!-- ═══ STATS ═════════════════════════════════════════════════════════════ -->
  <section class="stats">
    <div class="container">
      <div class="stats-row">
        <div class="stat"><span class="stat-num">300+</span><span class="stat-lbl">Edge locations</span></div>
        <div class="stat"><span class="stat-num">&lt;50ms</span><span class="stat-lbl">Delivery p50</span></div>
        <div class="stat"><span class="stat-num">50GB</span><span class="stat-lbl">Master plan storage</span></div>
        <div class="stat"><span class="stat-num">100%</span><span class="stat-lbl">Free tier, forever</span></div>
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ══════════════════════════════════════════════════════ -->
  <section class="how">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow eyebrow-tight">How it works</span>
        <h2 class="display-md">Live in thirty seconds.</h2>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-n">01</div>
          <h3>Create an account</h3>
          <p>Email and a strong password. No card, no dance.</p>
        </div>
        <div class="step">
          <div class="step-n">02</div>
          <h3>Upload &amp; organize</h3>
          <p>Drag-drop into folders. Bulk select, move, or delete anytime.</p>
        </div>
        <div class="step">
          <div class="step-n">03</div>
          <h3>Share the URL</h3>
          <p>Copy the permanent link. Paste into docs, chats, sites — anywhere.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══════════════════════════════════════════════════════════════ -->
  <section class="faq" id="faq">
    <div class="container faq-inner">
      <h2 class="display-md">Questions,<br/>answered.</h2>
      <div class="faq-list">
        <details class="faq-row">
          <summary>Is the free plan really free?</summary>
          <p>Yes. 100&nbsp;MB of storage and a generous upload window — no card required, no expiration.</p>
        </details>
        <details class="faq-row">
          <summary>Where are my images stored?</summary>
          <p>Cloudflare R2. Objects are keyed by your user ID and served through Workers with your session gating every request.</p>
        </details>
        <details class="faq-row">
          <summary>Can I delete everything cleanly?</summary>
          <p>Yes. Single or bulk deletes remove both the R2 object and the D1 row — no orphans, no traces.</p>
        </details>
        <details class="faq-row">
          <summary>What payment methods do you support?</summary>
          <p>Cashfree handles UPI, cards, net-banking, and wallets for Indian customers on Pro and Master plans.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ═══ CTA FINALE ════════════════════════════════════════════════════════ -->
  <section class="finale">
    <div class="container finale-inner">
      <h2 class="display-lg">Ship images<br/>like a professional.</h2>
      <div class="cta-row" style="justify-content:center;">
        <a href="/signup" class="pill pill-primary pill-lg">Create free account</a>
        <a href="/pricing" class="pill pill-secondary pill-lg">View plans</a>
      </div>
    </div>
  </section>

  <!-- ═══ FOOTER ════════════════════════════════════════════════════════════ -->
  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href="/" class="logo">
          <span class="logo-dot"></span>
          ImgHost
        </a>
        <p class="footer-tag">Secure image hosting on the edge.</p>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <div class="footer-h">Product</div>
          <a href="#features">Features</a>
          <a href="#security">Security</a>
          <a href="/pricing">Pricing</a>
        </div>
        <div class="footer-col">
          <div class="footer-h">Account</div>
          <a href="/login">Sign in</a>
          <a href="/signup">Sign up</a>
          <a href="/dashboard">Dashboard</a>
        </div>
        <div class="footer-col">
          <div class="footer-h">Built on</div>
          <a href="https://workers.cloudflare.com" rel="noreferrer">Workers</a>
          <a href="https://developers.cloudflare.com/r2/" rel="noreferrer">R2</a>
          <a href="https://developers.cloudflare.com/d1/" rel="noreferrer">D1</a>
        </div>
      </div>
      <div class="footer-base">
        <span>© 2026 ImgHost</span>
        <span class="sep">·</span>
        <span>Made for builders who care about security.</span>
      </div>
    </div>
  </footer>
  </div>

  <style>
    /* ─── Tokens (DESIGN.md) ─────────────────────────────────── */
    .landing {
      --canvas: #090909;
      --surface-1: #141414;
      --surface-2: #1c1c1c;
      --hairline: #262626;
      --hairline-soft: #1a1a1a;
      --ink: #ffffff;
      --ink-muted: #999999;
      --accent-blue: #0099ff;
      --g-magenta: #d44df0;
      --g-violet: #6a4cf5;
      --g-orange: #ff7a3d;
      --g-coral: #ff5577;
      --success: #22c55e;

      --display: 'Inter Tight', 'Inter', system-ui, sans-serif;
      --body: 'Inter', system-ui, sans-serif;

      background: var(--canvas);
      color: var(--ink);
      min-height: 100vh;
      overflow-x: clip;
    }
    .landing *, .landing *::before, .landing *::after { box-sizing: border-box; }
    .landing h1, .landing h2, .landing h3 { font-family: var(--display); font-weight: 500; }
    .landing ::selection { background: rgba(0,153,255,.35); color: #fff; }

    .container { max-width: 1200px; margin: 0 auto; padding: 0 28px; }

    /* ─── Pills (the only CTA shape) ─────────────────────────── */
    .pill {
      display: inline-flex; align-items: center; gap: 8px;
      font: 500 14px/1 var(--body); letter-spacing: -0.14px;
      border-radius: 100px; padding: 10px 16px;
      border: 1px solid transparent;
      transition: transform .12s ease, background .15s ease, border-color .15s ease;
      white-space: nowrap; cursor: pointer;
    }
    .pill:active { transform: scale(.97); }
    .pill-primary { background: #fff; color: #000; }
    .pill-primary:hover { background: #f2f2f2; }
    .pill-secondary { background: var(--surface-1); color: var(--ink); border-color: var(--hairline); }
    .pill-secondary:hover { background: var(--surface-2); }
    .pill-lg { padding: 13px 22px; font-size: 15px; }

    /* ─── Nav ────────────────────────────────────────────────── */
    .nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(9,9,9,.72);
      backdrop-filter: blur(14px) saturate(140%);
      border-bottom: 1px solid var(--hairline-soft);
    }
    .nav-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 28px; height: 64px;
      display: flex; align-items: center; justify-content: space-between; gap: 24px;
    }
    .logo {
      display: inline-flex; align-items: center; gap: 10px;
      font: 600 16px/1 var(--display); letter-spacing: -0.4px; color: var(--ink);
    }
    .logo-dot {
      width: 14px; height: 14px; border-radius: 50%;
      background: conic-gradient(from 210deg, var(--g-violet), var(--g-magenta), var(--g-orange), var(--g-violet));
      box-shadow: 0 0 20px rgba(212,77,240,.35);
    }
    .nav-center { display: flex; gap: 28px; }
    .nav-center a {
      font: 500 13.5px/1 var(--body); letter-spacing: -0.14px;
      color: var(--ink-muted);
    }
    .nav-center a:hover { color: var(--ink); }
    .nav-links { display: flex; align-items: center; gap: 8px; }
    @media (max-width: 900px) {
      .nav-center { display: none; }
    }
    @media (max-width: 540px) {
      .nav-links .pill-secondary { display: none; }
    }

    /* ─── Hero ───────────────────────────────────────────────── */
    .hero { position: relative; padding: 96px 28px 64px; }
    .hero::before, .hero::after {
      content: ""; position: absolute; pointer-events: none; z-index: 0;
      border-radius: 50%; filter: blur(110px);
    }
    .hero::before {
      width: 560px; height: 560px; top: -160px; left: -140px;
      background: radial-gradient(circle, rgba(106,76,245,.35), transparent 60%);
    }
    .hero::after {
      width: 520px; height: 520px; top: -80px; right: -160px;
      background: radial-gradient(circle, rgba(212,77,240,.25), transparent 60%);
    }
    .hero-inner {
      position: relative; z-index: 1; max-width: 1100px; margin: 0 auto;
      display: flex; flex-direction: column; align-items: flex-start; gap: 32px;
    }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 12px; border-radius: 100px;
      background: var(--surface-1); border: 1px solid var(--hairline);
      font: 500 13px/1 var(--body); letter-spacing: -0.13px; color: var(--ink-muted);
    }
    .eyebrow-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--success); box-shadow: 0 0 0 3px rgba(34,197,94,.18);
    }
    .eyebrow-tight {
      background: transparent; border: 0; padding: 0;
      text-transform: uppercase; letter-spacing: .12em; font-size: 12px; color: var(--ink-muted);
    }

    .display {
      font-family: var(--display); font-weight: 500;
      font-size: clamp(48px, 9.5vw, 110px);
      line-height: 0.88;
      letter-spacing: -0.05em;
      color: var(--ink);
      margin: 0;
    }
    .display .ink-muted { color: var(--ink-muted); }
    .display-lg {
      font-family: var(--display); font-weight: 500;
      font-size: clamp(40px, 6vw, 62px);
      line-height: 1.0; letter-spacing: -0.05em;
    }
    .display-md {
      font-family: var(--display); font-weight: 500;
      font-size: clamp(28px, 3.2vw, 44px);
      line-height: 1.08; letter-spacing: -0.032em;
    }

    .lead {
      font: 400 18px/1.35 var(--body); letter-spacing: -0.18px;
      color: var(--ink-muted); max-width: 560px;
    }
    .lead-sm {
      font: 400 16px/1.45 var(--body); letter-spacing: -0.15px;
      color: var(--ink-muted); max-width: 480px;
    }

    .cta-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .trust-row {
      display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
      font: 500 13px/1 var(--body); color: var(--ink-muted); letter-spacing: -0.13px;
    }
    .trust-row .sep { opacity: .5; }

    /* ─── Product mockup tile ────────────────────────────────── */
    .mockup {
      width: 100%; max-width: 720px; margin-top: 16px;
      background: var(--surface-1);
      border: 1px solid var(--hairline);
      border-radius: 20px; overflow: hidden;
      box-shadow: 0 1px 0 rgba(255,255,255,.05) inset, 0 30px 80px rgba(0,0,0,.45);
    }
    .mockup-chrome {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 16px; background: var(--surface-2);
      border-bottom: 1px solid var(--hairline);
    }
    .chrome-dots { display: flex; gap: 6px; }
    .chrome-dots i { width: 10px; height: 10px; border-radius: 50%; background: #2a2a2a; display: inline-block; }
    .chrome-url {
      font: 500 12px/1 var(--body); color: var(--ink-muted); letter-spacing: -0.12px;
      flex: 1; text-align: center;
    }
    .mockup-body { padding: 18px; display: flex; flex-direction: column; gap: 12px; }
    .mockup-upload {
      display: flex; align-items: center; gap: 14px;
      padding: 14px; background: var(--canvas); border: 1px solid var(--hairline);
      border-radius: 12px;
    }
    .mockup-thumb {
      width: 46px; height: 46px; border-radius: 10px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--g-orange), var(--g-coral) 55%, var(--g-magenta));
    }
    .mockup-file { font: 500 14px/1.2 var(--body); color: var(--ink); letter-spacing: -0.14px; }
    .mockup-bar { height: 4px; margin: 8px 0; background: #222; border-radius: 100px; overflow: hidden; }
    .mockup-bar-fill {
      width: 78%; height: 100%;
      background: linear-gradient(90deg, var(--g-violet), var(--g-magenta));
    }
    .mockup-meta { font: 500 12px/1.2 var(--body); color: var(--ink-muted); letter-spacing: -0.12px; }
    .mockup-status {
      font: 500 12px/1 var(--body); letter-spacing: -0.12px;
      padding: 5px 10px; border-radius: 100px;
      background: rgba(34,197,94,.12); color: var(--success); border: 1px solid rgba(34,197,94,.25);
    }
    .mockup-url {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 10px 14px; background: var(--canvas);
      border: 1px solid var(--hairline); border-radius: 12px;
    }
    .mockup-url-path {
      font: 500 12.5px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--ink-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .mockup-copy {
      font: 500 12px/1 var(--body); letter-spacing: -0.12px;
      padding: 6px 10px; border-radius: 100px;
      background: #fff; color: #000;
    }

    /* ─── Gradient spotlight cards ───────────────────────────── */
    .spotlight-section { padding: 40px 0 64px; }
    .spotlight-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
    }
    .spot {
      border-radius: 30px; padding: 36px;
      color: var(--ink); position: relative; overflow: hidden;
      min-height: 280px;
      display: flex; flex-direction: column; justify-content: space-between; gap: 20px;
      isolation: isolate;
    }
    .spot::after {
      content: ""; position: absolute; inset: 0; z-index: -1;
      background: radial-gradient(120% 90% at 20% 10%, rgba(255,255,255,.22), transparent 55%);
    }
    .spot-violet { background: linear-gradient(135deg, #4a2bc9 0%, var(--g-violet) 55%, #8a6df8 100%); }
    .spot-magenta { background: linear-gradient(135deg, #a028c4 0%, var(--g-magenta) 55%, #ff6fb3 100%); }
    .spot-orange { background: linear-gradient(135deg, #cc3b1a 0%, var(--g-orange) 55%, #ffb26b 100%); }
    .spot-tag {
      align-self: flex-start;
      font: 500 12px/1 var(--body); letter-spacing: .1em; text-transform: uppercase;
      padding: 7px 11px; border-radius: 100px;
      background: rgba(0,0,0,.25); color: #fff; backdrop-filter: blur(8px);
    }
    .spot-title {
      font: 500 clamp(28px, 3vw, 40px)/1.02 var(--display);
      letter-spacing: -0.035em; color: #fff; margin: 0;
    }
    .spot-body {
      font: 400 16px/1.4 var(--body); letter-spacing: -0.16px;
      color: rgba(255,255,255,.88); max-width: 420px;
    }
    @media (max-width: 820px) {
      .spotlight-grid { grid-template-columns: 1fr; }
      .spot { padding: 28px; min-height: 220px; }
    }

    /* ─── Section heading ────────────────────────────────────── */
    .section-head { margin-bottom: 48px; display: flex; flex-direction: column; gap: 12px; }

    /* ─── Features grid ──────────────────────────────────────── */
    .features { padding: 96px 0; }
    .feat-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    }
    .feat-card {
      background: var(--surface-1);
      border: 1px solid var(--hairline);
      border-radius: 20px; padding: 28px;
      display: flex; flex-direction: column; gap: 10px;
      transition: border-color .18s ease, background .18s ease, transform .18s ease;
    }
    .feat-card:hover {
      border-color: #3a3a3a; background: var(--surface-2);
      transform: translateY(-2px);
    }
    .feat-glyph {
      font: 500 14px/1 ui-monospace, SFMono-Regular, monospace;
      color: var(--ink-muted); letter-spacing: 0;
      padding: 6px 10px; align-self: flex-start;
      background: var(--canvas); border: 1px solid var(--hairline); border-radius: 100px;
    }
    .feat-card h3 {
      font: 700 22px/1.2 'Inter', var(--body); letter-spacing: -0.8px; color: var(--ink); margin: 8px 0 0;
    }
    .feat-card p {
      font: 400 15px/1.45 var(--body); letter-spacing: -0.15px; color: var(--ink-muted);
    }
    @media (max-width: 900px) { .feat-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .feat-grid { grid-template-columns: 1fr; } }

    /* ─── Security band ──────────────────────────────────────── */
    .security { padding: 96px 0; border-top: 1px solid var(--hairline-soft); border-bottom: 1px solid var(--hairline-soft); }
    .security-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: stretch;
    }
    .security-copy { display: flex; flex-direction: column; gap: 20px; }
    .security-list {
      list-style: none; padding: 0; margin: 8px 0 0;
      display: flex; flex-direction: column; gap: 12px;
    }
    .security-list li {
      display: flex; align-items: flex-start; gap: 12px;
      font: 400 15px/1.4 var(--body); letter-spacing: -0.15px; color: var(--ink);
    }
    .security-list code {
      font: 500 13px/1 ui-monospace, SFMono-Regular, monospace;
      background: var(--surface-1); border: 1px solid var(--hairline);
      padding: 2px 6px; border-radius: 6px; color: var(--ink);
    }
    .check {
      width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
      background: rgba(34,197,94,.15); border: 1px solid rgba(34,197,94,.35);
      position: relative; margin-top: 1px;
    }
    .check::after {
      content: ""; position: absolute; left: 6px; top: 3px;
      width: 5px; height: 10px; border: solid var(--success);
      border-width: 0 2px 2px 0; transform: rotate(45deg);
    }
    .security-spot { min-height: 320px; }
    @media (max-width: 900px) {
      .security-grid { grid-template-columns: 1fr; }
    }

    /* ─── Stats ──────────────────────────────────────────────── */
    .stats { padding: 64px 0; }
    .stats-row {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
      padding: 28px; background: var(--surface-1);
      border: 1px solid var(--hairline); border-radius: 20px;
    }
    .stat { display: flex; flex-direction: column; gap: 6px; }
    .stat-num {
      font: 500 clamp(28px, 3vw, 40px)/1 var(--display);
      letter-spacing: -0.04em; color: var(--ink);
    }
    .stat-lbl {
      font: 500 13px/1.2 var(--body); letter-spacing: -0.13px;
      text-transform: uppercase; color: var(--ink-muted);
    }
    @media (max-width: 720px) { .stats-row { grid-template-columns: repeat(2, 1fr); } }

    /* ─── How it works ───────────────────────────────────────── */
    .how { padding: 96px 0; }
    .steps {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    }
    .step {
      background: var(--surface-1); border: 1px solid var(--hairline);
      border-radius: 20px; padding: 28px;
      display: flex; flex-direction: column; gap: 12px;
    }
    .step-n {
      font: 500 14px/1 ui-monospace, monospace;
      padding: 6px 10px; align-self: flex-start; border-radius: 100px;
      background: var(--canvas); border: 1px solid var(--hairline); color: var(--ink-muted);
    }
    .step h3 { font: 700 22px/1.2 'Inter', var(--body); letter-spacing: -0.8px; color: var(--ink); }
    .step p { font: 400 15px/1.45 var(--body); letter-spacing: -0.15px; color: var(--ink-muted); }
    @media (max-width: 780px) { .steps { grid-template-columns: 1fr; } }

    /* ─── FAQ ────────────────────────────────────────────────── */
    .faq { padding: 96px 0; border-top: 1px solid var(--hairline-soft); }
    .faq-inner {
      display: grid; grid-template-columns: minmax(260px, 380px) 1fr; gap: 48px; align-items: flex-start;
    }
    .faq-list { display: flex; flex-direction: column; gap: 8px; }
    .faq-row {
      background: var(--canvas); border: 1px solid var(--hairline);
      border-radius: 10px; padding: 20px 24px;
      transition: background .18s, border-color .18s;
    }
    .faq-row[open] { background: var(--surface-1); border-color: #333; }
    .faq-row summary {
      cursor: pointer; list-style: none;
      display: flex; justify-content: space-between; align-items: center; gap: 16px;
      font: 500 16px/1.3 var(--body); letter-spacing: -0.15px; color: var(--ink);
    }
    .faq-row summary::-webkit-details-marker { display: none; }
    .faq-row summary::after {
      content: "+"; font: 400 22px/1 var(--body); color: var(--ink-muted); transition: transform .18s;
    }
    .faq-row[open] summary::after { content: "–"; }
    .faq-row p {
      font: 400 15px/1.5 var(--body); letter-spacing: -0.15px;
      color: var(--ink-muted); margin-top: 14px;
    }
    @media (max-width: 820px) {
      .faq-inner { grid-template-columns: 1fr; gap: 24px; }
    }

    /* ─── Finale ─────────────────────────────────────────────── */
    .finale {
      padding: 120px 0; text-align: center;
      position: relative; overflow: hidden;
    }
    .finale::before {
      content: ""; position: absolute; inset: 0; z-index: 0;
      background: radial-gradient(60% 60% at 50% 40%, rgba(106,76,245,.22), transparent 70%);
    }
    .finale-inner {
      position: relative; z-index: 1;
      display: flex; flex-direction: column; align-items: center; gap: 32px;
    }

    /* ─── Footer ─────────────────────────────────────────────── */
    .footer { background: var(--canvas); border-top: 1px solid var(--hairline-soft); padding: 64px 0 40px; }
    .footer-inner {
      display: grid; grid-template-columns: 1.3fr 2fr; gap: 48px;
    }
    .footer-brand { display: flex; flex-direction: column; gap: 10px; max-width: 280px; }
    .footer-tag { font: 400 13px/1.4 var(--body); letter-spacing: -0.13px; color: var(--ink-muted); }
    .footer-cols {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
    }
    .footer-col { display: flex; flex-direction: column; gap: 10px; }
    .footer-h {
      font: 500 12px/1 var(--body); letter-spacing: .12em; text-transform: uppercase;
      color: var(--ink); margin-bottom: 6px;
    }
    .footer-col a {
      font: 500 13px/1 var(--body); letter-spacing: -0.13px; color: var(--ink-muted);
    }
    .footer-col a:hover { color: var(--ink); }
    .footer-base {
      grid-column: 1 / -1;
      margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--hairline-soft);
      font: 500 13px/1 var(--body); letter-spacing: -0.13px; color: var(--ink-muted);
      display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
    }
    .footer-base .sep { opacity: .5; }
    @media (max-width: 780px) {
      .footer-inner { grid-template-columns: 1fr; gap: 32px; }
      .footer-cols { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 520px) {
      .footer-cols { grid-template-columns: 1fr 1fr; }
    }

    /* ─── Focus states (DESIGN.md: single blue accent) ───────── */
    .landing a:focus-visible,
    .landing button:focus-visible,
    .landing summary:focus-visible {
      outline: none;
      box-shadow: 0 0 0 3px rgba(0,153,255,.35);
      border-radius: 100px;
    }
  </style>
</Layout>

