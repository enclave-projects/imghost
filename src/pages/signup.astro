---
import Layout from '../layouts/Layout.astro';
export const prerender = false;
---
<Layout title="Create Account">
  <div class="auth-wrap">
    <!-- Left panel -->
    <aside class="auth-panel">
      <div class="panel-inner">
        <a href="/" class="logo">
          <div class="logo-icon">
            <img src="https://img.icons8.com/?id=yRoFUHiH0uft&format=png&size=28" alt="" width="28" height="28" />
          </div>
          ImgHost
        </a>
        <div class="panel-content">
          <img src="https://img.icons8.com/?id=FbRY9JkBrjiX&format=png&size=96" alt="Secure" class="hero-icon" width="96" height="96" />
          <h2>Free, fast &amp; secure.</h2>
          <p>No credit card needed. Start hosting images in seconds on Cloudflare's edge network.</p>
          <div class="stat-row">
            <div class="stat"><span class="stat-val">300+</span><span class="stat-lbl">Edge locations</span></div>
            <div class="stat"><span class="stat-val">10 MB</span><span class="stat-lbl">Max per image</span></div>
            <div class="stat"><span class="stat-val">Free</span><span class="stat-lbl">Always</span></div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Right form -->
    <main class="auth-form-wrap">
      <div class="auth-form">
        <a href="/" class="back-link">← Back to home</a>
        <div class="badge">Free forever</div>
        <h1>Create your account</h1>
        <p class="sub">No credit card required. Ready in seconds.</p>

        <div id="error" class="alert"></div>

        <form id="form">
          <div class="field">
            <label class="label" for="email">Email address</label>
            <input id="email" type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
          </div>
          <div class="field">
            <label class="label" for="password">
              Password
              <span class="hint">min 8 characters</span>
            </label>
            <div class="pw-wrap">
              <input id="password" type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="••••••••" />
              <div class="pw-strength" id="pw-strength">
                <div class="bar" id="bar-1"></div>
                <div class="bar" id="bar-2"></div>
                <div class="bar" id="bar-3"></div>
                <div class="bar" id="bar-4"></div>
                <span class="pw-label" id="pw-label"></span>
              </div>
            </div>
          </div>
          <button type="submit" class="btn btn-primary submit-btn" id="submit">
            Create free account
            <svg id="submit-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>

        <div class="divider"><span>Already have an account?</span></div>
        <a href="/login" class="btn btn-outline switch-btn">Sign in instead</a>

        <p class="terms">By creating an account you agree to our terms of service.</p>
      </div>
    </main>
  </div>

  <style>
    .auth-wrap { min-height: 100vh; display: flex; }

    .auth-panel {
      display: none; width: 420px; flex-shrink: 0;
      background: linear-gradient(145deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
      position: relative; overflow: hidden;
    }
    @media (min-width: 900px) { .auth-panel { display: flex; } }
    .auth-panel::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse at 30% 70%, rgba(91,94,244,.3) 0%, transparent 60%);
    }
    .panel-inner {
      position: relative; z-index: 1; padding: 40px;
      display: flex; flex-direction: column; height: 100%;
    }
    .logo {
      display: inline-flex; align-items: center; gap: 10px;
      color: #fff; font-weight: 800; font-size: 18px;
      text-decoration: none; letter-spacing: -.02em;
    }
    .logo-icon {
      width: 38px; height: 38px; background: rgba(255,255,255,.15);
      border-radius: 10px; display: flex; align-items: center; justify-content: center;
    }
    .panel-content { margin-top: auto; margin-bottom: auto; padding-top: 40px; }
    .hero-icon { margin-bottom: 24px; filter: drop-shadow(0 8px 32px rgba(91,94,244,.4)); }
    .panel-content h2 {
      font-size: 1.7rem; font-weight: 800; color: #fff;
      letter-spacing: -.03em; line-height: 1.2; margin-bottom: 12px;
    }
    .panel-content p { color: rgba(255,255,255,.7); font-size: 14.5px; line-height: 1.6; margin-bottom: 32px; }

    .stat-row { display: flex; gap: 24px; }
    .stat { display: flex; flex-direction: column; gap: 2px; }
    .stat-val { font-size: 20px; font-weight: 800; color: #fff; letter-spacing: -.02em; }
    .stat-lbl { font-size: 12px; color: rgba(255,255,255,.5); font-weight: 500; }

    .auth-form-wrap {
      flex: 1; display: flex; align-items: center;
      justify-content: center; padding: 40px 24px; background: var(--bg);
    }
    .auth-form { width: 100%; max-width: 400px; }

    .back-link {
      display: inline-block; font-size: 13px; color: var(--text-muted);
      text-decoration: none; margin-bottom: 20px; transition: color .15s;
    }
    .back-link:hover { color: var(--text); text-decoration: none; }

    .badge {
      display: inline-flex; align-items: center;
      padding: 3px 10px; background: var(--primary-light); color: var(--primary);
      border-radius: var(--r-full); font-size: 12px; font-weight: 600;
      letter-spacing: .02em; margin-bottom: 14px;
    }

    h1 { font-size: 1.75rem; font-weight: 800; letter-spacing: -.04em; color: var(--text); margin-bottom: 6px; }
    .sub { font-size: 14px; color: var(--text-muted); margin-bottom: 28px; }
    .hint { font-weight: 500; color: var(--text-faint); text-transform: none; font-size: 11px; letter-spacing: 0; margin-left: 6px; }

    /* Password strength */
    .pw-wrap { display: flex; flex-direction: column; gap: 8px; }
    .pw-strength { display: flex; align-items: center; gap: 4px; }
    .bar { height: 3px; flex: 1; border-radius: 99px; background: var(--border); transition: background .2s; }
    .bar.weak { background: var(--error); }
    .bar.fair { background: var(--warning); }
    .bar.good { background: #22c55e; }
    .bar.strong { background: var(--success); }
    .pw-label { font-size: 11px; font-weight: 600; color: var(--text-muted); min-width: 40px; }

    .submit-btn { width: 100%; padding: 12px; font-size: 15px; margin-top: 4px; }

    .divider {
      display: flex; align-items: center; gap: 12px;
      margin: 24px 0 16px; color: var(--text-faint); font-size: 13px;
    }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .switch-btn { width: 100%; padding: 11px; font-size: 14px; }
    .terms { margin-top: 16px; font-size: 12px; color: var(--text-faint); text-align: center; }
  </style>

  <script>
    const form = document.getElementById('form') as HTMLFormElement;
    const errorEl = document.getElementById('error')!;
    const submitBtn = document.getElementById('submit') as HTMLButtonElement;
    const pwInput = document.getElementById('password') as HTMLInputElement;
    const bars = [
      document.getElementById('bar-1')!,
      document.getElementById('bar-2')!,
      document.getElementById('bar-3')!,
      document.getElementById('bar-4')!,
    ];
    const pwLabel = document.getElementById('pw-label')!;

    function getStrength(pw: string): number {
      let s = 0;
      if (pw.length >= 8) s++;
      if (pw.length >= 12) s++;
      if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) s++;
      if (/\d/.test(pw) || /[^A-Za-z0-9]/.test(pw)) s++;
      return s;
    }

    pwInput.addEventListener('input', () => {
      const s = getStrength(pwInput.value);
      const cls = ['', 'weak', 'fair', 'good', 'strong'];
      const labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
      bars.forEach((b, i) => { b.className = 'bar' + (i < s ? ' ' + cls[s] : ''); });
      pwLabel.textContent = pwInput.value ? labels[s] : '';
      pwLabel.style.color = s === 1 ? 'var(--error)' : s === 2 ? 'var(--warning)' : s >= 3 ? 'var(--success)' : '';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.className = 'alert';
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner" style="width:16px;height:16px;border-width:2px"></span> Creating account…';

      const data = new FormData(form);
      try {
        const res = await fetch('/api/auth/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: data.get('email'), password: data.get('password') }),
        });
        const json = await res.json() as { ok?: boolean; error?: string };
        if (json.ok) {
          window.location.href = '/dashboard';
        } else {
          errorEl.className = 'alert alert-error';
          errorEl.textContent = json.error ?? 'Signup failed';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Create free account →';
        }
      } catch {
        errorEl.className = 'alert alert-error';
        errorEl.textContent = 'Network error. Please try again.';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create free account →';
      }
    });
  </script>
</Layout>
