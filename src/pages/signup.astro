---
import Layout from '../layouts/Layout.astro';
export const prerender = false;
---
<Layout title="Create Account">
  <div class="auth-wrap">
    <!-- Left panel — orange gradient spotlight -->
    <aside class="auth-panel">
      <div class="panel-inner">
        <a href="/" class="logo">
          <span class="logo-dot"></span>
          ImgHost
        </a>
        <div class="panel-content">
          <span class="panel-eyebrow">Free forever</span>
          <h2>Ship images<br/>like a pro.</h2>
          <p>Upload, organize, and share — all from 300+ Cloudflare edge locations. No card. No setup. No egress fees.</p>
          <div class="stat-row">
            <div class="stat"><span class="stat-val">300+</span><span class="stat-lbl">Edge locations</span></div>
            <div class="stat"><span class="stat-val">&lt;50ms</span><span class="stat-lbl">Delivery p50</span></div>
            <div class="stat"><span class="stat-val">Free</span><span class="stat-lbl">Forever</span></div>
          </div>
        </div>
        <div class="panel-foot">Built on Cloudflare Workers · R2 · D1</div>
      </div>
    </aside>

    <!-- Right form -->
    <main class="auth-form-wrap">
      <div class="auth-form">
        <a href="/" class="mobile-logo">
          <span class="logo-dot"></span>
          ImgHost
        </a>
        <a href="/" class="back-link">← Back to home</a>
        <div class="badge">Free forever</div>
        <h1>Create your<br/>account.</h1>
        <p class="sub">No credit card required. Ready in seconds.</p>

        <div id="error" class="alert"></div>

        <form id="form">
          <div class="field">
            <label class="label" for="email">Email address</label>
            <input id="email" type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
          </div>
          <div class="field">
            <label class="label" for="password">
              Password
              <span class="hint">min 8 characters</span>
            </label>
            <div class="pw-wrap">
              <input id="password" type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="••••••••" />
              <div class="pw-strength" id="pw-strength">
                <div class="bar" id="bar-1"></div>
                <div class="bar" id="bar-2"></div>
                <div class="bar" id="bar-3"></div>
                <div class="bar" id="bar-4"></div>
                <span class="pw-label" id="pw-label"></span>
              </div>
            </div>
          </div>
          <button type="submit" class="btn btn-primary submit-btn" id="submit">
            Create free account
            <svg id="submit-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>

        <div class="divider"><span>Already have an account?</span></div>
        <a href="/login" class="btn btn-outline switch-btn">Sign in instead</a>

        <p class="terms">By creating an account you agree to our terms of service.</p>
      </div>
    </main>
  </div>

  <style>
    .auth-wrap { min-height: 100vh; display: flex; background: var(--canvas); }

    .auth-panel {
      display: none; width: 480px; flex-shrink: 0; position: relative; overflow: hidden;
      background: linear-gradient(135deg, #cc3b1a 0%, var(--g-orange) 45%, #ff8a5c 80%, var(--g-coral) 100%);
    }
    @media (min-width: 960px) { .auth-panel { display: flex; } }
    .auth-panel::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(120% 80% at 20% 10%, rgba(255,255,255,.22), transparent 55%);
    }
    .auth-panel::after {
      content: ''; position: absolute; inset: auto -80px -80px auto;
      width: 360px; height: 360px; border-radius: 50%; pointer-events: none;
      background: radial-gradient(circle, rgba(212,77,240,.35), transparent 65%);
      filter: blur(20px);
    }
    .panel-inner {
      position: relative; z-index: 1; padding: 48px;
      display: flex; flex-direction: column; height: 100%; color: #fff;
    }
    .logo {
      display: inline-flex; align-items: center; gap: 10px;
      color: #fff; font-family: var(--font-display);
      font-weight: 600; font-size: 17px;
      letter-spacing: -0.4px; text-decoration: none;
    }
    .logo-dot {
      width: 14px; height: 14px; border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 20px rgba(255,255,255,.6);
    }
    .panel-content {
      margin-top: auto; margin-bottom: auto; padding-top: 48px;
      display: flex; flex-direction: column; gap: 24px;
    }
    .panel-eyebrow {
      align-self: flex-start;
      font-size: 12px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase;
      padding: 7px 11px; border-radius: 100px;
      background: rgba(0,0,0,.25); backdrop-filter: blur(8px);
    }
    .panel-content h2 {
      font-family: var(--font-display);
      font-size: clamp(34px, 4vw, 52px); font-weight: 500;
      color: #fff; letter-spacing: -0.04em; line-height: 1.0;
    }
    .panel-content p { color: rgba(255,255,255,.88); font-size: 16px; line-height: 1.4; letter-spacing: -0.16px; max-width: 380px; }

    .stat-row { display: flex; gap: 28px; margin-top: 12px; }
    .stat { display: flex; flex-direction: column; gap: 4px; }
    .stat-val { font-family: var(--font-display); font-size: 28px; font-weight: 500; color: #fff; letter-spacing: -0.04em; line-height: 1; }
    .stat-lbl { font-size: 12px; color: rgba(255,255,255,.75); font-weight: 500; letter-spacing: -0.12px; }

    .panel-foot { margin-top: auto; padding-top: 32px; font-size: 12px; color: rgba(255,255,255,.75); letter-spacing: -0.12px; }

    .auth-form-wrap {
      flex: 1; display: flex; align-items: center;
      justify-content: center; padding: 40px 24px; background: var(--canvas);
      position: relative;
    }
    .auth-form-wrap::before {
      content: ''; position: absolute; pointer-events: none;
      top: -120px; right: -120px; width: 400px; height: 400px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,122,61,.15), transparent 60%);
      filter: blur(80px);
    }
    .auth-form { width: 100%; max-width: 420px; position: relative; z-index: 1; }

    .mobile-logo {
      display: flex; align-items: center; gap: 10px; margin-bottom: 32px;
      font-family: var(--font-display); font-weight: 600; font-size: 17px;
      letter-spacing: -0.4px; color: var(--text);
    }
    .mobile-logo .logo-dot {
      background: conic-gradient(from 210deg, var(--g-violet), var(--g-magenta), var(--g-orange), var(--g-violet));
      box-shadow: 0 0 20px rgba(212,77,240,.35);
    }
    @media (min-width: 960px) { .mobile-logo { display: none; } }

    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; color: var(--text-muted);
      margin-bottom: 20px; transition: color .15s;
    }
    .back-link:hover { color: var(--text); }

    .badge {
      display: inline-flex; align-items: center;
      padding: 6px 12px; background: var(--surface); color: var(--text);
      border: 1px solid var(--border);
      border-radius: 100px; font-size: 12px; font-weight: 500;
      letter-spacing: -0.12px; margin-bottom: 16px;
    }

    h1 {
      font-family: var(--font-display);
      font-size: clamp(32px, 4vw, 48px); font-weight: 500;
      letter-spacing: -0.04em; line-height: 1.02;
      color: var(--text); margin-bottom: 10px;
    }
    .sub { font-size: 16px; color: var(--text-muted); margin-bottom: 32px; letter-spacing: -0.16px; }
    .hint { font-weight: 400; color: var(--text-faint); text-transform: none; font-size: 11px; letter-spacing: -0.11px; margin-left: 8px; }

    /* Password strength */
    .pw-wrap { display: flex; flex-direction: column; gap: 8px; }
    .pw-strength { display: flex; align-items: center; gap: 5px; }
    .bar { height: 3px; flex: 1; border-radius: 100px; background: var(--border); transition: background .2s; }
    .bar.weak { background: var(--error); }
    .bar.fair { background: var(--warning); }
    .bar.good { background: #22c55e; }
    .bar.strong { background: var(--success); }
    .pw-label { font-size: 11px; font-weight: 500; color: var(--text-muted); min-width: 40px; letter-spacing: -0.11px; }

    .submit-btn { width: 100%; padding: 14px; font-size: 15px; margin-top: 8px; }

    .divider {
      display: flex; align-items: center; gap: 12px;
      margin: 28px 0 14px; color: var(--text-faint); font-size: 13px; letter-spacing: -0.13px;
    }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .switch-btn { width: 100%; padding: 13px; font-size: 14px; }
    .terms { margin-top: 20px; font-size: 12px; color: var(--text-faint); text-align: center; letter-spacing: -0.12px; }
  </style>

  <script>
    const form = document.getElementById('form') as HTMLFormElement;
    const errorEl = document.getElementById('error')!;
    const submitBtn = document.getElementById('submit') as HTMLButtonElement;
    const pwInput = document.getElementById('password') as HTMLInputElement;
    const bars = [
      document.getElementById('bar-1')!,
      document.getElementById('bar-2')!,
      document.getElementById('bar-3')!,
      document.getElementById('bar-4')!,
    ];
    const pwLabel = document.getElementById('pw-label')!;

    function getStrength(pw: string): number {
      let s = 0;
      if (pw.length >= 8) s++;
      if (pw.length >= 12) s++;
      if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) s++;
      if (/\d/.test(pw) || /[^A-Za-z0-9]/.test(pw)) s++;
      return s;
    }

    pwInput.addEventListener('input', () => {
      const s = getStrength(pwInput.value);
      const cls = ['', 'weak', 'fair', 'good', 'strong'];
      const labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
      bars.forEach((b, i) => { b.className = 'bar' + (i < s ? ' ' + cls[s] : ''); });
      pwLabel.textContent = pwInput.value ? labels[s] : '';
      pwLabel.style.color = s === 1 ? 'var(--error)' : s === 2 ? 'var(--warning)' : s >= 3 ? 'var(--success)' : '';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.className = 'alert';
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner" style="width:16px;height:16px;border-width:2px"></span> Creating account…';

      const data = new FormData(form);
      try {
        const res = await fetch('/api/auth/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: data.get('email'), password: data.get('password') }),
        });
        const json = await res.json() as { ok?: boolean; error?: string };
        if (json.ok) {
          window.location.href = '/dashboard';
        } else {
          errorEl.className = 'alert alert-error';
          errorEl.textContent = json.error ?? 'Signup failed';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Create free account →';
        }
      } catch {
        errorEl.className = 'alert alert-error';
        errorEl.textContent = 'Network error. Please try again.';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create free account →';
      }
    });
  </script>
</Layout>
