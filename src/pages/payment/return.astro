---
import Layout from '../../layouts/Layout.astro';
export const prerender = false;
const orderId = Astro.url.searchParams.get('order_id') ?? '';
---
<Layout title="Payment">

<header class="top-nav">
  <div class="top-nav-inner">
    <a href="/" class="logo">
      <span class="logo-dot"></span>
      ImgHost
    </a>
  </div>
</header>

<main class="return-main">
  <div class="return-card" id="return-card">
    <div class="return-spinner" id="spinner">
      <div class="spinner"></div>
    </div>
    <h1 class="return-title" id="title">Verifying payment…</h1>
    <p class="return-sub" id="subtitle">Please wait while we confirm your order with Cashfree.</p>
    <div class="return-actions" id="actions" hidden>
      <a href="/dashboard" class="btn btn-primary">Go to dashboard</a>
      <a href="/pricing" class="btn btn-ghost">Back to pricing</a>
    </div>
  </div>
</main>

</Layout>

<script define:vars={{ orderId }}>
(async function () {
  const title    = document.getElementById('title');
  const subtitle = document.getElementById('subtitle');
  const spinner  = document.getElementById('spinner');
  const actions  = document.getElementById('actions');
  const card     = document.getElementById('return-card');

  function render(state, t, s) {
    card.dataset.state = state;
    title.textContent = t;
    subtitle.textContent = s;
    spinner.hidden = true;
    actions.hidden = false;
  }

  if (!orderId) {
    render('error', 'Missing order reference', 'We could not find your order. If you were charged, contact support.');
    return;
  }

  try {
    const res  = await fetch('/api/payments/verify?order_id=' + encodeURIComponent(orderId));
    const data = await res.json();
    if (!res.ok || !data.ok) {
      render('error', 'Verification failed', data.error || 'We could not verify your payment. Please try again or contact support.');
      return;
    }
    if (data.status === 'PAID') {
      render('ok', 'Payment successful ✓', `Your ${data.plan.charAt(0).toUpperCase() + data.plan.slice(1)} plan is now active. Enjoy the extra storage!`);
    } else if (data.status === 'ACTIVE') {
      render('pending', 'Payment pending', 'Your payment has not been completed yet. If you were charged, please check back shortly.');
    } else if (data.status === 'EXPIRED') {
      render('error', 'Order expired', 'This order expired before payment was completed. Please start again.');
    } else {
      render('error', 'Payment not completed', 'Your payment did not go through. You can try again from the pricing page.');
    }
  } catch (err) {
    render('error', 'Something went wrong', err.message || 'Please try again.');
  }
})();
</script>

<style>
  .top-nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(9,9,9,.72); backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--border);
  }
  .top-nav-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 28px; height: 64px;
    display: flex; align-items: center;
  }
  .logo {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-display); font-weight: 600; font-size: 16px;
    letter-spacing: -0.4px; color: var(--text);
  }
  .logo-dot {
    width: 14px; height: 14px; border-radius: 50%;
    background: conic-gradient(from 210deg, var(--g-violet), var(--g-magenta), var(--g-orange), var(--g-violet));
    box-shadow: 0 0 20px rgba(212,77,240,.35);
  }

  .return-main {
    position: relative;
    min-height: calc(100vh - 64px);
    display: flex; align-items: center; justify-content: center;
    padding: 40px 24px;
  }
  .return-main::before {
    content: ''; position: absolute; pointer-events: none;
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 800px; height: 500px; border-radius: 50%;
    background: radial-gradient(circle, rgba(106,76,245,.18), transparent 60%);
    filter: blur(100px); z-index: 0;
  }
  .return-card {
    position: relative; z-index: 1;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 48px 36px;
    max-width: 480px; width: 100%; text-align: center;
    box-shadow: var(--shadow-md);
    transition: border-color .2s;
  }
  .return-card[data-state="ok"]      { border-color: rgba(34,197,94,.4); }
  .return-card[data-state="error"]   { border-color: rgba(239,68,68,.4); }
  .return-card[data-state="pending"] { border-color: rgba(245,158,11,.4); }

  .return-spinner { display: flex; justify-content: center; margin-bottom: 24px; }
  .spinner {
    width: 40px; height: 40px; border-radius: 50%;
    border: 3px solid var(--border); border-top-color: var(--text);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .return-title {
    font-family: var(--font-display);
    font-size: 32px; font-weight: 500;
    color: var(--text); margin-bottom: 12px;
    letter-spacing: -0.04em; line-height: 1.05;
  }
  .return-sub {
    font-size: 15px; color: var(--text-muted);
    line-height: 1.5; letter-spacing: -0.15px;
  }
  .return-actions {
    margin-top: 32px;
    display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;
  }
</style>
