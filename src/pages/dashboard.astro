---
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { getUserById } from '../lib/db';
import { getPlan } from '../lib/plans';
export const prerender = false;
const user = Astro.locals.user!;
let currentPlanId = 'free';
if (env?.DB) {
  const dbUser = await getUserById(env.DB, user.id);
  currentPlanId = dbUser?.plan ?? 'free';
}
const currentPlan = getPlan(currentPlanId);
---
<Layout title="Dashboard">

<!-- ═══ APP SHELL ═════════════════════════════════════════════════════════════ -->
<div class="app-shell" id="app-shell">

  <!-- ── Sidebar ──────────────────────────────────────────────────────── -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-head">
      <a href="/" class="logo">
        <span class="logo-dot"></span>
        <span class="logo-name">ImgHost</span>
      </a>
      <button class="sidebar-close" id="sidebar-close" type="button" aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <nav class="side-nav">
      <span class="side-section">Workspace</span>
      <a href="/dashboard" class="side-item active">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        Library
      </a>
      <a href="#" class="side-item" data-scrollto="upload-card">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Upload
      </a>
      <a href="#" class="side-item" data-scrollto="stats-row">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><polyline points="7 14 11 10 15 13 21 7"/></svg>
        Storage
      </a>

      <span class="side-section">Account</span>
      <a href="/profile" class="side-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
        Profile &amp; billing
      </a>
      <a href="/pricing" class="side-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15 8.5 22 9.3 17 14.1 18.2 21 12 17.8 5.8 21 7 14.1 2 9.3 9 8.5 12 2"/></svg>
        Plans
      </a>
      <a href="/" class="side-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12 12 3l9 9"/><path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10"/></svg>
        Home
      </a>
    </nav>

    <div class="sidebar-foot">
      <a href="/pricing" class={`plan-pill plan-pill-${currentPlan.id}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15 8.5 22 9.3 17 14.1 18.2 21 12 17.8 5.8 21 7 14.1 2 9.3 9 8.5 12 2"/></svg>
        <span class="plan-pill-text">
          <span class="plan-pill-label">Current plan</span>
          <span class="plan-pill-name">{currentPlan.name}</span>
        </span>
        {currentPlan.id === 'free' && <span class="plan-pill-cta">Upgrade →</span>}
      </a>
      <button class="btn btn-outline btn-block logout-btn" id="logout-btn" type="button">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign out
      </button>
    </div>
  </aside>

  <!-- Sidebar scrim (mobile) -->
  <div class="sidebar-scrim" id="sidebar-scrim"></div>

  <!-- ── Content area ─────────────────────────────────────────────────── -->
  <div class="content-area">

    <!-- Top bar -->
    <header class="top-bar">
      <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-title">
        <span class="page-eyebrow">Workspace</span>
        <h1>Library</h1>
      </div>
      <div class="top-bar-right">
        <div class="user-chip">
          <div class="avatar">{user.email.charAt(0).toUpperCase()}</div>
          <span class="user-email">{user.email}</span>
        </div>
      </div>
    </header>

    <!-- Main scrollable -->
    <main class="main">

      <!-- ── Stats row (3 compact tiles) ─────────────────────────────── -->
      <section class="stats-row" id="stats-row">

        <!-- Storage tile -->
        <div class="stat-tile" id="storage-quota-card">
          <div class="stat-tile-head">
            <div class="stat-icon stat-icon-violet">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v6c0 1.7 4 3 9 3s9-1.3 9-3V5"/><path d="M3 11v6c0 1.7 4 3 9 3s9-1.3 9-3v-6"/></svg>
            </div>
            <span class="stat-label">Storage</span>
          </div>
          <div class="stat-value" id="storage-text">—</div>
          <div class="quota-track">
            <div class="quota-fill" id="storage-fill" style="width:0%"></div>
          </div>
          <div class="quota-numbers" id="storage-numbers"></div>
        </div>

        <!-- Hourly quota tile -->
        <div class="stat-tile" id="quota-card">
          <div class="stat-tile-head">
            <div class="stat-icon stat-icon-orange">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
            </div>
            <span class="stat-label">Hourly upload quota</span>
          </div>
          <div class="stat-value" id="quota-text">—</div>
          <div class="quota-track">
            <div class="quota-fill" id="quota-fill" style="width:0%"></div>
          </div>
          <div class="quota-numbers" id="quota-numbers"></div>
        </div>

        <!-- Files tile -->
        <div class="stat-tile">
          <div class="stat-tile-head">
            <div class="stat-icon stat-icon-blue">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            </div>
            <span class="stat-label">Files</span>
          </div>
          <div class="stat-value" id="stat-files-count">—</div>
          <div class="stat-foot" id="stat-files-foot">across <span id="stat-folders-count">0</span> folders</div>
        </div>

      </section>

      <!-- ── Upload zone ─────────────────────────────────────────────── -->
      <section class="upload-card" id="drop-zone">
        <div class="upload-idle" id="upload-idle">
          <div class="upload-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </div>
          <div class="upload-text">
            <p class="upload-title">Drop files to upload</p>
            <p class="upload-hint" id="upload-hint">Loading plan limits…</p>
          </div>
          <label class="btn btn-primary choose-btn" for="file-input">
            Choose files
          </label>
          <input type="file" id="file-input" accept="image/*,video/*" multiple hidden />
        </div>

        <div class="upload-active" id="upload-active" hidden>
          <div class="upload-file-name" id="upload-file-name">Uploading…</div>
          <div class="xhr-track">
            <div class="xhr-fill" id="xhr-fill"></div>
          </div>
          <div class="xhr-meta">
            <span id="xhr-pct">0%</span>
            <span id="xhr-speed"></span>
            <span id="xhr-of"></span>
          </div>
        </div>

        <div class="batch-bar" id="batch-bar" hidden>
          <div class="batch-steps" id="batch-steps"></div>
        </div>

        <div id="upload-error" class="alert" style="margin-top:14px;"></div>
      </section>

  <!-- Gallery -->
  <section class="gallery-section">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" id="breadcrumbs">
      <button class="crumb" data-folder="all" type="button">All files</button>
      <span class="crumb-sep">/</span>
      <button class="crumb" data-folder="root" type="button">Root</button>
    </nav>

    <div class="gallery-header">
      <div class="gallery-title-row">
        <img src="https://img.icons8.com/?id=yRoFUHiH0uft&format=png&size=24" alt="" width="24" height="24" />
        <h2 id="gallery-heading">Your media</h2>
        <span class="img-badge" id="img-count"></span>
      </div>
      <div class="gallery-actions" id="gallery-actions" hidden>
        <button class="btn btn-outline btn-sm" id="new-folder-btn" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
          New folder
        </button>
        <button class="btn btn-ghost btn-sm" id="select-toggle-btn" type="button">Select</button>
        <span class="sort-label">Newest first</span>
      </div>
    </div>

    <!-- Folders grid (only on 'all' or 'root' view) -->
    <div id="folders-section" hidden>
      <div class="folders-grid" id="folders-grid"></div>
    </div>

    <!-- Bulk action bar -->
    <div class="bulk-bar" id="bulk-bar" hidden>
      <div class="bulk-left">
        <button class="bulk-close" id="bulk-close-btn" type="button" title="Cancel selection">✕</button>
        <span id="bulk-count">0 selected</span>
      </div>
      <div class="bulk-actions">
        <button class="btn btn-outline btn-sm" id="bulk-select-all" type="button">Select all</button>
        <button class="btn btn-outline btn-sm" id="bulk-move-btn" type="button" disabled>Move…</button>
        <button class="btn btn-danger btn-sm" id="bulk-delete-btn" type="button" disabled>Delete</button>
      </div>
    </div>

    <div id="gallery-loading" class="gallery-state">
      <div class="spinner"></div>
      <p>Loading your media…</p>
    </div>

    <div id="gallery-empty" class="gallery-state" hidden>
      <img src="https://img.icons8.com/?id=yRoFUHiH0uft&format=png&size=64" alt="" width="64" height="64" style="opacity:.25;filter:grayscale(1)" />
      <p class="empty-title">No files yet</p>
      <p class="empty-sub">Upload your first image or video above to get started</p>
    </div>

    <div id="gallery" class="gallery" hidden></div>

    <div id="load-more-wrap" hidden style="text-align:center;margin-top:28px;">
      <button class="btn btn-outline" id="load-more-btn">Load more</button>
    </div>
  </section>
    </main>
  </div>
</div>

<!-- Media card template -->
<template id="img-tpl">
  <div class="img-card">
    <div class="img-thumb">
      <img loading="lazy" decoding="async" />
      <!-- Video placeholder (shown for videos instead of img) -->
      <div class="vid-thumb" hidden>
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="48" height="48" rx="4" fill="#1e1b4b"/>
          <path d="M18 14L34 24L18 34V14Z" fill="#a78bfa"/>
        </svg>
      </div>
      <div class="vid-play-overlay" hidden>
        <div class="vid-play-btn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
        </div>
      </div>
      <label class="select-check" title="Select">
        <input type="checkbox" class="select-input" />
        <span class="select-box"></span>
      </label>
      <div class="img-actions">
        <button class="action-btn copy-btn" title="Copy embed code">
          <img src="https://img.icons8.com/?id=s30bO0DNz4I5&format=png&size=18" alt="Copy" width="18" height="18" />
          <span class="action-label">Copy embed</span>
        </button>
        <button class="action-btn move-btn" title="Move to folder">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        </button>
        <button class="action-btn delete-btn" title="Delete">
          <img src="https://img.icons8.com/?id=BJkQWseLWhe4&format=png&size=18" alt="Delete" width="18" height="18" />
        </button>
      </div>
      <div class="img-type-badge"></div>
    </div>
    <div class="img-info">
      <p class="img-name"></p>
      <div class="img-meta-row">
        <span class="img-size"></span>
        <span class="img-dot">·</span>
        <span class="img-date"></span>
      </div>
    </div>
  </div>
</template>

<!-- Generic modal: New folder -->
<div id="new-folder-modal" class="app-modal" hidden>
  <div class="app-modal-backdrop" data-close></div>
  <div class="app-modal-box">
    <h3>New folder</h3>
    <p class="app-modal-sub">Create a folder to organize your media.</p>
    <input id="new-folder-input" type="text" maxlength="60" placeholder="e.g. Vacation 2025" class="app-input" />
    <div id="new-folder-error" class="app-modal-error" hidden></div>
    <div class="app-modal-actions">
      <button class="btn btn-ghost btn-sm" data-close type="button">Cancel</button>
      <button class="btn btn-primary btn-sm" id="new-folder-confirm" type="button">Create</button>
    </div>
  </div>
</div>

<!-- Move-to-folder modal -->
<div id="move-modal" class="app-modal" hidden>
  <div class="app-modal-backdrop" data-close></div>
  <div class="app-modal-box">
    <h3 id="move-modal-title">Move</h3>
    <p class="app-modal-sub">Choose a destination folder.</p>
    <div id="move-folder-list" class="folder-picker"></div>
    <div class="app-modal-actions">
      <button class="btn btn-ghost btn-sm" data-close type="button">Cancel</button>
    </div>
  </div>
</div>

<!-- Folder delete confirm -->
<div id="folder-delete-modal" class="app-modal" hidden>
  <div class="app-modal-backdrop" data-close></div>
  <div class="app-modal-box">
    <h3>Delete folder</h3>
    <p class="app-modal-sub" id="folder-delete-sub">What should happen to the files inside?</p>
    <div class="app-modal-actions" style="flex-wrap:wrap;gap:8px;">
      <button class="btn btn-ghost btn-sm" data-close type="button">Cancel</button>
      <button class="btn btn-outline btn-sm" id="folder-delete-move" type="button">Move files to root</button>
      <button class="btn btn-danger btn-sm" id="folder-delete-purge" type="button">Delete files too</button>
    </div>
  </div>
</div>

<!-- Video modal -->
<div id="video-modal" class="vid-modal" hidden>
  <div class="vid-modal-backdrop"></div>
  <div class="vid-modal-box">
    <button class="vid-modal-close" id="vid-close">✕</button>
    <video id="vid-player" controls playsinline style="width:100%;max-height:80vh;border-radius:8px;background:#000;"></video>
    <div class="vid-modal-meta" id="vid-modal-meta"></div>
  </div>
</div>

<style>
  /* ─── App shell ────────────────────────────────────────────── */
  .app-shell {
    --sidebar-w: 240px;
    --topbar-h: 64px;
    min-height: 100vh;
    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    background: var(--canvas);
  }
  @media (max-width: 900px) {
    .app-shell { grid-template-columns: 1fr; }
  }

  /* ─── Sidebar ──────────────────────────────────────────────── */
  .sidebar {
    position: sticky; top: 0; height: 100vh;
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column;
    padding: 18px 14px 16px;
    z-index: 60;
  }
  @media (max-width: 900px) {
    .sidebar {
      position: fixed; top: 0; left: 0; bottom: 0;
      width: 280px; height: 100vh;
      transform: translateX(-100%);
      transition: transform .25s var(--ease);
      box-shadow: var(--shadow-lg);
    }
    .app-shell.menu-open .sidebar { transform: translateX(0); }
  }
  .sidebar-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 4px 8px 18px;
  }
  .logo {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-display); font-weight: 600; font-size: 16px;
    letter-spacing: -0.4px; color: var(--text);
    text-decoration: none;
  }
  .logo-dot {
    width: 14px; height: 14px; border-radius: 50%;
    background: conic-gradient(from 210deg, var(--g-violet), var(--g-magenta), var(--g-orange), var(--g-violet));
    box-shadow: 0 0 20px rgba(212,77,240,.35);
    flex-shrink: 0;
  }
  .sidebar-close {
    display: none; background: transparent; border: none;
    color: var(--text-muted); cursor: pointer; padding: 6px;
    border-radius: 100px;
  }
  .sidebar-close:hover { background: var(--surface-2); color: var(--text); }
  @media (max-width: 900px) { .sidebar-close { display: flex; } }

  .side-nav {
    flex: 1; display: flex; flex-direction: column; gap: 2px;
    overflow-y: auto;
  }
  .side-section {
    padding: 14px 12px 6px;
    font-size: 11px; font-weight: 500; letter-spacing: .12em;
    text-transform: uppercase; color: var(--text-faint);
  }
  .side-section:first-child { padding-top: 4px; }
  .side-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px; border-radius: 10px;
    font-size: 14px; font-weight: 500; letter-spacing: -0.14px;
    color: var(--text-muted); cursor: pointer;
    transition: background .15s, color .15s;
  }
  .side-item svg { flex-shrink: 0; opacity: .85; }
  .side-item:hover { background: var(--surface-2); color: var(--text); }
  .side-item.active {
    background: var(--surface-2); color: var(--text);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .sidebar-foot {
    border-top: 1px solid var(--border);
    padding-top: 14px; margin-top: 14px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .plan-pill {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 12px 12px 14px;
    border-radius: 14px;
    text-decoration: none;
    transition: transform .15s ease;
  }
  .plan-pill:hover { transform: translateY(-1px); }
  .plan-pill-text { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .plan-pill-label {
    font-size: 10px; font-weight: 500; letter-spacing: .12em;
    text-transform: uppercase; opacity: .8;
  }
  .plan-pill-name {
    font-family: var(--font-display);
    font-size: 15px; font-weight: 500; letter-spacing: -0.02em;
    margin-top: 2px;
  }
  .plan-pill-cta { font-size: 12px; font-weight: 500; letter-spacing: -0.12px; opacity: .9; }
  .plan-pill-free   { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); }
  .plan-pill-pro    { background: linear-gradient(135deg, var(--g-violet), var(--g-magenta)); color: #fff; box-shadow: 0 4px 18px rgba(106,76,245,.35); }
  .plan-pill-master { background: linear-gradient(135deg, var(--g-orange), var(--g-coral)); color: #fff; box-shadow: 0 4px 18px rgba(255,122,61,.35); }
  .btn-block { width: 100%; }
  .logout-btn { justify-content: flex-start; }

  .sidebar-scrim {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,.55); backdrop-filter: blur(2px);
    z-index: 55;
  }
  @media (max-width: 900px) {
    .app-shell.menu-open .sidebar-scrim { display: block; }
  }

  /* ─── Content area ─────────────────────────────────────────── */
  .content-area {
    min-width: 0;   /* allow shrinking inside grid */
    display: flex; flex-direction: column;
  }

  /* ─── Top bar ──────────────────────────────────────────────── */
  .top-bar {
    position: sticky; top: 0; z-index: 40;
    height: var(--topbar-h);
    display: flex; align-items: center; gap: 14px;
    padding: 0 28px;
    background: rgba(9,9,9,.78);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 600px) { .top-bar { padding: 0 16px; } }
  .menu-toggle {
    display: none; background: transparent; border: none;
    color: var(--text); cursor: pointer; padding: 8px;
    border-radius: 100px;
  }
  .menu-toggle:hover { background: var(--surface); }
