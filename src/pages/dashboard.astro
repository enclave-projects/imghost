<script>
  // ── Types ─────────────────────────────────────────────────────────────────
  interface ImageItem {
    id: number;
    filename: string;
    size: number;
    contentType: string;
    mediaType: 'image' | 'video';
    url: string;
    createdAt: string;
    folderId?: number | null;
  }
  interface FolderItem { id: number; name: string; count: number; createdAt: string; }
  interface PlanInfo {
    id: string;
    name: string;
    maxImageBytes: number;
    maxVideoBytes: number;
  }
  interface ImagesResponse {
    ok: boolean;
    images: ImageItem[];
    folders?: FolderItem[];
    plan?: PlanInfo;
    uploadsUsed: number;
    uploadsLimit: number;
    uploadsWindowMinutes?: number;
    storageUsed: number;
    storageLimit: number;
    error?: string;
  }
  type FolderView = 'all' | 'root' | number;

  // ── State ─────────────────────────────────────────────────────────────────
  let images: ImageItem[] = [];
  let offset = 0;
  const LIMIT = 50;
  const ALLOWED_IMAGES = new Set(['image/jpeg','image/png','image/gif','image/webp','image/avif','image/svg+xml','image/bmp']);
  const ALLOWED_VIDEOS = new Set(['video/mp4','video/webm','video/quicktime','video/x-msvideo','video/x-matroska','video/ogg']);
  let uploadsUsed = 0;
  let uploadsLimit = 10;
  let uploadsWindowMinutes = 60;
  let storageUsed = 0;
  let storageLimit = 500 * 1024 * 1024;
  let maxImageSize = 10 * 1024 * 1024;
  let maxVideoSize = 100 * 1024 * 1024;
  let planName = 'Free';

  // Folder + selection state
  let folders: FolderItem[] = [];
  let currentView: FolderView = 'all';
  let selectMode = false;
  const selected = new Set<number>();

  // ── Elements ──────────────────────────────────────────────────────────────
  const gallery      = document.getElementById('gallery')!;
  const galleryLoad  = document.getElementById('gallery-loading')!;
  const galleryEmpty = document.getElementById('gallery-empty')!;
  const imgCount     = document.getElementById('img-count')!;
  const dropZone     = document.getElementById('drop-zone')!;
  const fileInput    = document.getElementById('file-input') as HTMLInputElement;
  const uploadIdle   = document.getElementById('upload-idle')!;
  const uploadActive = document.getElementById('upload-active')!;
  const uploadFileName = document.getElementById('upload-file-name')!;
  const xhrFill      = document.getElementById('xhr-fill') as HTMLElement;
  const xhrPct       = document.getElementById('xhr-pct')!;
  const xhrSpeed     = document.getElementById('xhr-speed')!;
  const xhrOf        = document.getElementById('xhr-of')!;
  const batchBar     = document.getElementById('batch-bar')!;
  const batchSteps   = document.getElementById('batch-steps')!;
  const uploadError  = document.getElementById('upload-error')!;
  const loadMoreWrap = document.getElementById('load-more-wrap')!;
  const loadMoreBtn  = document.getElementById('load-more-btn')!;
  const quotaFill    = document.getElementById('quota-fill') as HTMLElement;
  const quotaText    = document.getElementById('quota-text')!;
  const quotaNumbers = document.getElementById('quota-numbers')!;
  const galleryActions = document.getElementById('gallery-actions')!;
  const tpl          = document.getElementById('img-tpl') as HTMLTemplateElement;
  const storageFill  = document.getElementById('storage-fill') as HTMLElement;
  const storageText  = document.getElementById('storage-text')!;
  const storageNumbers = document.getElementById('storage-numbers')!;
  const videoModal   = document.getElementById('video-modal')!;
  const vidPlayer    = document.getElementById('vid-player') as HTMLVideoElement;
  const vidClose     = document.getElementById('vid-close')!;
  const vidModalMeta = document.getElementById('vid-modal-meta')!;

  // ── Helpers ───────────────────────────────────────────────────────────────
  function fmt(b: number) {
    if (b < 1024) return `${b} B`;
    if (b < 1048576) return `${(b/1024).toFixed(1)} KB`;
    if (b < 1073741824) return `${(b/1048576).toFixed(1)} MB`;
    return `${(b/1073741824).toFixed(2)} GB`;
  }
  // Large-size formatter: used for plan limits (whole units, no decimals when clean)
  function fmtLimit(b: number) {
    const GB = 1073741824, MB = 1048576;
    if (b >= GB) {
      const v = b / GB;
      return `${v % 1 === 0 ? v.toFixed(0) : v.toFixed(2)} GB`;
    }
    return `${Math.round(b / MB)} MB`;
  }
  function fmtWindow(m: number) {
    return m === 60 ? '1 hr' : `${m} min`;
  }
  function fmtDate(iso: string) {
    return new Date(iso + (iso.endsWith('Z') ? '' : 'Z')).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }
  function extOf(ct: string) {
    const map: Record<string,string> = {
      'image/jpeg':'jpg','image/png':'png','image/gif':'gif','image/webp':'webp',
      'image/avif':'avif','image/svg+xml':'svg','image/bmp':'bmp',
      'video/mp4':'mp4','video/webm':'webm','video/quicktime':'mov',
      'video/x-msvideo':'avi','video/x-matroska':'mkv','video/ogg':'ogv',
    };
    return map[ct] ?? ct.split('/')[1] ?? '?';
  }
  function showErr(msg: string) {
    uploadError.className = 'alert alert-error';
    uploadError.textContent = msg;
    setTimeout(() => { uploadError.className = 'alert'; }, 8000);
  }

  // ── Quota bars ────────────────────────────────────────────────────────────
  function updateQuota() {
    const pct = uploadsLimit > 0 ? Math.min((uploadsUsed / uploadsLimit) * 100, 100) : 0;
    quotaFill.style.width = `${pct}%`;
    quotaFill.className = 'quota-fill' + (pct >= 90 ? ' danger' : pct >= 70 ? ' warn' : '');
    const remaining = Math.max(uploadsLimit - uploadsUsed, 0);
    const windowLabel = fmtWindow(uploadsWindowMinutes);
    quotaText.textContent = remaining === 0
      ? `Limit reached — resets within ${windowLabel}`
      : `${remaining} upload${remaining !== 1 ? 's' : ''} remaining in the current ${windowLabel} window`;
    quotaNumbers.innerHTML = `<span>${uploadsUsed} used</span><span>${uploadsLimit} / ${uploadsWindowMinutes === 60 ? '1hr' : uploadsWindowMinutes + 'min'} limit</span>`;
  }

  function updateStorageBar() {
    const pct = storageLimit > 0 ? Math.min((storageUsed / storageLimit) * 100, 100) : 0;
    storageFill.style.width = `${pct}%`;
    storageFill.className = 'quota-fill' + (pct >= 100 ? ' danger' : pct >= 80 ? ' warn' : '');
    const usedMB = (storageUsed / 1048576).toFixed(1);
    const limitMB = (storageLimit / 1048576).toFixed(0);
    const freeMB = Math.max((storageLimit - storageUsed) / 1048576, 0).toFixed(1);
    const freeLabel  = fmtLimit(Math.max(storageLimit - storageUsed, 0));
    const usedLabel  = fmt(storageUsed);
    const limitLabel = fmtLimit(storageLimit);
    storageText.textContent = pct >= 80
      ? (pct >= 100 ? 'Storage full — delete files to upload more' : `Storage almost full — ${freeLabel} remaining`)
      : `${freeLabel} free`;
    storageNumbers.innerHTML = `<span>${usedLabel} used</span><span>${limitLabel} total</span>`;
    void usedMB; void limitMB; void freeMB;
  }

  function updateUploadHint() {
    const el = document.getElementById('upload-hint');
    if (!el) return;
    el.innerHTML = `Images: JPEG · PNG · WebP · GIF · AVIF · SVG · BMP (max ${fmtLimit(maxImageSize)}) &nbsp;|&nbsp; Videos: MP4 · WebM · MOV · AVI · MKV (max ${fmtLimit(maxVideoSize)})`;
  }

  // ── Video modal ───────────────────────────────────────────────────────────
  function openVideo(url: string, filename: string, size: number) {
    vidPlayer.src = url;
    vidModalMeta.textContent = `${filename} · ${fmt(size)}`;
    videoModal.hidden = false;
    document.body.style.overflow = 'hidden';
    vidPlayer.play().catch(() => {});
  }
  function closeVideo() {
    vidPlayer.pause();
    vidPlayer.src = '';
    videoModal.hidden = true;
    document.body.style.overflow = '';
  }
  vidClose.addEventListener('click', closeVideo);
  videoModal.querySelector('.vid-modal-backdrop')!.addEventListener('click', closeVideo);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !videoModal.hidden) closeVideo(); });

  // ── Gallery ───────────────────────────────────────────────────────────────
  function makeCard(img: ImageItem): HTMLElement {
    const node = tpl.content.cloneNode(true) as DocumentFragment;
    const card = node.querySelector('.img-card') as HTMLElement;
    card.dataset.id = String(img.id);
    card.dataset.mediaType = img.mediaType ?? 'image';

    const isVideo = img.mediaType === 'video';

    const imgEl = card.querySelector('img') as HTMLImageElement;
    const vidThumb = card.querySelector('.vid-thumb') as HTMLElement;
    const vidOverlay = card.querySelector('.vid-play-overlay') as HTMLElement;
    const thumb = card.querySelector('.img-thumb') as HTMLElement;

    if (isVideo) {
      imgEl.hidden = true;
      vidThumb.hidden = false;
      vidOverlay.hidden = false;
    } else {
      imgEl.src = img.url;
      imgEl.alt = img.filename;
    }

    // Selection support
    const selectInput = card.querySelector('.select-input') as HTMLInputElement;
    const selectCheck = card.querySelector('.select-check') as HTMLLabelElement;
    selectInput.checked = selected.has(img.id);
    if (selectInput.checked) card.classList.add('selected');
    selectCheck.addEventListener('click', (e) => e.stopPropagation());
    selectInput.addEventListener('change', () => {
      if (selectInput.checked) { selected.add(img.id); card.classList.add('selected'); }
      else { selected.delete(img.id); card.classList.remove('selected'); }
      updateBulkBar();
    });

    // Card click: in select mode toggles, otherwise opens video for videos
    thumb.addEventListener('click', (e) => {
      // ignore clicks on action buttons / checkbox
      const t = e.target as HTMLElement;
      if (t.closest('.action-btn') || t.closest('.select-check')) return;
      if (selectMode) {
        selectInput.checked = !selectInput.checked;
        selectInput.dispatchEvent(new Event('change'));
        return;
      }
      if (isVideo) openVideo(img.url, img.filename, img.size);
    });
    if (isVideo) card.style.cursor = 'pointer';

    (card.querySelector('.img-name') as HTMLElement).textContent = img.filename;
    (card.querySelector('.img-size') as HTMLElement).textContent = fmt(img.size);
    (card.querySelector('.img-date') as HTMLElement).textContent = fmtDate(img.createdAt);
    const badge = card.querySelector('.img-type-badge') as HTMLElement;
    badge.textContent = extOf(img.contentType);
    if (isVideo) badge.style.background = 'rgba(91,33,182,.75)';

    const copyBtn = card.querySelector('.copy-btn') as HTMLButtonElement;
    const copyLabel = copyBtn.querySelector('.action-label')!;
    copyBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const embedCode = isVideo
        ? `<video src="${img.url}" controls style="max-width:100%"></video>`
        : `<img src="${img.url}" alt="${img.filename}" />`;
      try {
        await navigator.clipboard.writeText(embedCode);
        copyLabel.textContent = 'Copied!';
        copyBtn.classList.add('copied');
        setTimeout(() => { copyLabel.textContent = 'Copy embed'; copyBtn.classList.remove('copied'); }, 2000);
      } catch { prompt('Copy embed code:', embedCode); }
    });

    const moveBtn = card.querySelector('.move-btn') as HTMLButtonElement;
    moveBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openMoveModal([img.id], img.folderId ?? null);
    });

    const delBtn = card.querySelector('.delete-btn') as HTMLButtonElement;
    delBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      if (!confirm(`Delete "${img.filename}"?\nThis cannot be undone.`)) return;
      delBtn.disabled = true;
      card.style.opacity = '.5';
      try {
        const res = await fetch(`/api/images/${img.id}`, { method: 'DELETE' });
        const json = await res.json() as { ok?: boolean; error?: string };
        if (json.ok) {
          card.remove();
          images = images.filter(i => i.id !== img.id);
          storageUsed = Math.max(storageUsed - img.size, 0);
          updateStorageBar();
          updateCount();
          if (images.length === 0) { gallery.hidden = true; galleryEmpty.hidden = false; galleryActions.hidden = true; }
        } else { alert(json.error ?? 'Delete failed'); card.style.opacity = '1'; }
      } catch { alert('Network error'); card.style.opacity = '1'; }
      delBtn.disabled = false;
    });
    return card;
  }

  function updateCount() {
    imgCount.textContent = images.length > 0 ? String(images.length) : '';
  }

  // ── Load images ───────────────────────────────────────────────────────────
  function folderQuery(): string {
    if (currentView === 'all') return 'all';
    if (currentView === 'root') return 'root';
    return String(currentView);
  }

  async function loadImages(append = false) {
    if (!append) {
      galleryLoad.hidden = false; gallery.hidden = true; galleryEmpty.hidden = true;
      offset = 0;
      // Clear selection when switching views (kept across pagination only)
      selected.clear();
      updateBulkBar();
    }
    try {
      const res = await fetch(`/api/images?limit=${LIMIT}&offset=${offset}&folder_id=${encodeURIComponent(folderQuery())}`);
      if (res.status === 401) { window.location.href = '/login'; return; }
      const data = await res.json() as ImagesResponse;
      if (!data.ok) throw new Error(data.error ?? 'Failed to load');

      if (!append) {
        uploadsUsed = data.uploadsUsed ?? 0;
        uploadsLimit = data.uploadsLimit ?? 10;
        uploadsWindowMinutes = data.uploadsWindowMinutes ?? 60;
        storageUsed = data.storageUsed ?? 0;
        storageLimit = data.storageLimit ?? 500 * 1024 * 1024;
        if (data.plan) {
          maxImageSize = data.plan.maxImageBytes ?? maxImageSize;
          maxVideoSize = data.plan.maxVideoBytes ?? maxVideoSize;
          planName     = data.plan.name ?? planName;
        }
        updateUploadHint();
        updateQuota();
        updateStorageBar();
        folders = data.folders ?? [];
        renderFolders();
        renderBreadcrumbs();
      }

      const newImgs = data.images ?? [];
      if (append) {
        newImgs.forEach(img => { images.push(img); gallery.appendChild(makeCard(img)); });
      } else {
        images = newImgs;
        gallery.innerHTML = '';
        newImgs.forEach(img => gallery.appendChild(makeCard(img)));
      }
      offset += newImgs.length;
      updateCount();
      galleryLoad.hidden = true;
      if (images.length === 0) { galleryEmpty.hidden = false; galleryActions.hidden = true; }
      else { gallery.hidden = false; galleryActions.hidden = false; }
      loadMoreWrap.hidden = newImgs.length < LIMIT;
    } catch (err) {
      galleryLoad.hidden = true;
      galleryEmpty.hidden = false;
      console.error(err);
    }
  }

  // ── XHR upload with real-time progress ───────────────────────────────────
  function uploadXHR(file: File): Promise<{ ok: boolean; image?: ImageItem; error?: string }> {
    return new Promise((resolve) => {
      const xhr = new XMLHttpRequest();
      const fd = new FormData();
      fd.append('file', file);
      // Upload into current folder when viewing a specific folder
      if (typeof currentView === 'number') fd.append('folder_id', String(currentView));
      let startTime = Date.now();

      xhr.upload.addEventListener('progress', (e) => {
        if (!e.lengthComputable) return;
        const pct = Math.round((e.loaded / e.total) * 100);
        xhrFill.style.width = `${pct}%`;
        xhrPct.textContent = `${pct}%`;
        const elapsed = (Date.now() - startTime) / 1000;
        const speed = elapsed > 0.5 ? e.loaded / elapsed : 0;
        xhrSpeed.textContent = speed > 0 ? `${fmt(Math.round(speed))}/s` : '';
        xhrOf.textContent = `${fmt(e.loaded)} / ${fmt(e.total)}`;
      });

      xhr.addEventListener('load', () => {
        try { resolve(JSON.parse(xhr.responseText)); }
        catch { resolve({ ok: false, error: 'Invalid response' }); }
      });
      xhr.addEventListener('error', () => resolve({ ok: false, error: 'Network error' }));
      xhr.addEventListener('timeout', () => resolve({ ok: false, error: 'Upload timed out' }));

      xhr.open('POST', '/api/upload');
      xhr.timeout = 120000;
      xhr.send(fd);
    });
  }

  async function uploadFiles(files: File[]) {
    uploadError.className = 'alert';
    const valid = files.filter(f => {
      const isImg = ALLOWED_IMAGES.has(f.type);
      const isVid = ALLOWED_VIDEOS.has(f.type);
      if (!isImg && !isVid) { showErr(`"${f.name}" is not a supported image or video type.`); return false; }
      if (f.size === 0) { showErr(`"${f.name}" is empty.`); return false; }
      if (isImg && f.size > maxImageSize) { showErr(`"${f.name}" exceeds the ${fmtLimit(maxImageSize)} image limit on the ${planName} plan (${fmt(f.size)}).`); return false; }
      if (isVid && f.size > maxVideoSize) { showErr(`"${f.name}" exceeds the ${fmtLimit(maxVideoSize)} video limit on the ${planName} plan (${fmt(f.size)}).`); return false; }
      return true;
    });
    if (valid.length === 0) return;

    // Build batch step indicators
    batchSteps.innerHTML = '';
    const steps = valid.map(() => { const d = document.createElement('div'); d.className = 'batch-step'; batchSteps.appendChild(d); return d; });
    batchBar.hidden = false;

    uploadIdle.hidden = true;
    uploadActive.hidden = false;

    let successCount = 0;
    for (let i = 0; i < valid.length; i++) {
      const file = valid[i];
      steps[i].className = 'batch-step active';
      uploadFileName.textContent = valid.length > 1 ? `Uploading "${file.name}" (${i+1}/${valid.length})` : `Uploading "${file.name}"`;
      xhrFill.style.width = '0%';
      xhrPct.textContent = '0%';
      xhrSpeed.textContent = '';
      xhrOf.textContent = '';

      try {
        const json = await uploadXHR(file);
        if (json.ok && json.image) {
          images.unshift(json.image);
          gallery.prepend(makeCard(json.image));
          gallery.hidden = false;
          galleryEmpty.hidden = true;
          galleryActions.hidden = false;
          offset++;
          uploadsUsed++;
          storageUsed += json.image.size;
          updateCount();
          updateQuota();
          updateStorageBar();
          steps[i].className = 'batch-step done';
          successCount++;
        } else {
          steps[i].className = 'batch-step error';
          showErr(json.error ?? `Failed to upload "${file.name}"`);
        }
      } catch (err) {
        steps[i].className = 'batch-step error';
        showErr(`Upload failed for "${file.name}". Please try again.`);
        console.error(err);
      }
    }

    // Done
    setTimeout(() => {
      uploadIdle.hidden = false;
      uploadActive.hidden = true;
      batchBar.hidden = true;
    }, 1800);
    fileInput.value = '';
  }

  // ── Events ────────────────────────────────────────────────────────────────
  fileInput.addEventListener('change', () => {
    const files = Array.from(fileInput.files ?? []);
    if (files.length > 0) uploadFiles(files);
  });

  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone.addEventListener('dragleave', (e) => {
    if (!dropZone.contains(e.relatedTarget as Node)) dropZone.classList.remove('drag-over');
  });
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const files = Array.from(e.dataTransfer?.files ?? []).filter(f => f.type.startsWith('image/') || f.type.startsWith('video/'));
    if (files.length > 0) uploadFiles(files);
  });

  loadMoreBtn.addEventListener('click', () => loadImages(true));

  document.getElementById('logout-btn')!.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/';
  });

  // ── Folders, breadcrumbs, selection & bulk ────────────────────────────────
  const breadcrumbsEl = document.getElementById('breadcrumbs')!;
  const galleryHeading = document.getElementById('gallery-heading')!;
  const foldersSection = document.getElementById('folders-section')!;
  const foldersGrid    = document.getElementById('folders-grid')!;
  const newFolderBtn   = document.getElementById('new-folder-btn') as HTMLButtonElement;
  const selectToggleBtn = document.getElementById('select-toggle-btn') as HTMLButtonElement;
  const bulkBar        = document.getElementById('bulk-bar')!;
  const bulkCountEl    = document.getElementById('bulk-count')!;
  const bulkCloseBtn   = document.getElementById('bulk-close-btn') as HTMLButtonElement;
  const bulkSelectAll  = document.getElementById('bulk-select-all') as HTMLButtonElement;
  const bulkMoveBtn    = document.getElementById('bulk-move-btn') as HTMLButtonElement;
  const bulkDeleteBtn  = document.getElementById('bulk-delete-btn') as HTMLButtonElement;
  const newFolderModal = document.getElementById('new-folder-modal')!;
  const newFolderInput = document.getElementById('new-folder-input') as HTMLInputElement;
  const newFolderError = document.getElementById('new-folder-error')!;
  const newFolderConfirm = document.getElementById('new-folder-confirm') as HTMLButtonElement;
  const moveModal      = document.getElementById('move-modal')!;
  const moveModalTitle = document.getElementById('move-modal-title')!;
  const moveFolderList = document.getElementById('move-folder-list')!;
  const folderDelModal = document.getElementById('folder-delete-modal')!;
  const folderDelSub   = document.getElementById('folder-delete-sub')!;
  const folderDelMove  = document.getElementById('folder-delete-move') as HTMLButtonElement;
  const folderDelPurge = document.getElementById('folder-delete-purge') as HTMLButtonElement;

  function renderBreadcrumbs() {
    breadcrumbsEl.innerHTML = '';
    const mk = (label: string, view: FolderView, active: boolean) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'crumb' + (active ? ' active' : '');
      b.textContent = label;
      b.addEventListener('click', () => navigateTo(view));
      return b;
    };
    breadcrumbsEl.appendChild(mk('All files', 'all', currentView === 'all'));
    breadcrumbsEl.append(Object.assign(document.createElement('span'), { className: 'crumb-sep', textContent: '/' }));
    breadcrumbsEl.appendChild(mk('Root', 'root', currentView === 'root'));
    if (typeof currentView === 'number') {
      const f = folders.find((x) => x.id === currentView);
      breadcrumbsEl.append(Object.assign(document.createElement('span'), { className: 'crumb-sep', textContent: '/' }));
      breadcrumbsEl.appendChild(mk(f?.name ?? 'Folder', currentView, true));
    }
    galleryHeading.textContent = typeof currentView === 'number'
      ? (folders.find((x) => x.id === currentView)?.name ?? 'Folder')
      : (currentView === 'root' ? 'Root files' : 'Your media');
  }

  function renderFolders() {
    foldersGrid.innerHTML = '';
    // Show folder grid only on the "All files" view (top-level browsing)
    if (currentView !== 'all' || folders.length === 0) {
      foldersSection.hidden = true;
      return;
    }
    foldersSection.hidden = false;
    for (const f of folders) {
      const card = document.createElement('div');
      card.className = 'folder-card';
      card.innerHTML = `
        <div class="folder-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        </div>
        <div class="folder-info">
          <div class="folder-name"></div>
          <div class="folder-count"></div>
        </div>
        <button class="folder-menu" type="button" title="Folder options">⋯</button>
      `;
      (card.querySelector('.folder-name') as HTMLElement).textContent = f.name;
      (card.querySelector('.folder-count') as HTMLElement).textContent =
        `${f.count} item${f.count === 1 ? '' : 's'}`;
      card.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('.folder-menu') || t.closest('.folder-menu-pop')) return;
        navigateTo(f.id);
      });
      const menuBtn = card.querySelector('.folder-menu') as HTMLButtonElement;
      menuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        // Close any open menu
        document.querySelectorAll('.folder-menu-pop').forEach((el) => el.remove());
        const pop = document.createElement('div');
        pop.className = 'folder-menu-pop';
        pop.innerHTML = `
          <button data-act="rename">Rename</button>
          <button data-act="delete" class="danger">Delete</button>
        `;
        card.appendChild(pop);
        pop.addEventListener('click', (ev) => {
          ev.stopPropagation();
          const act = (ev.target as HTMLElement).getAttribute('data-act');
          pop.remove();
          if (act === 'rename') promptRenameFolder(f);
          else if (act === 'delete') openFolderDeleteModal(f);
        });
        const onDocClick = () => { pop.remove(); document.removeEventListener('click', onDocClick); };
        setTimeout(() => document.addEventListener('click', onDocClick), 0);
      });
      foldersGrid.appendChild(card);
    }
  }

  function navigateTo(view: FolderView) {
    currentView = view;
    setSelectMode(false);
    loadImages(false);
  }

  // ── Selection mode + bulk bar ────────────────────────────────────────────
  function setSelectMode(on: boolean) {
    selectMode = on;
    document.body.classList.toggle('select-mode', on);
    selectToggleBtn.textContent = on ? 'Done' : 'Select';
    if (!on) {
      selected.clear();
      gallery.querySelectorAll('.img-card.selected').forEach((c) => c.classList.remove('selected'));
      gallery.querySelectorAll<HTMLInputElement>('.select-input').forEach((i) => (i.checked = false));
    }
    updateBulkBar();
  }

  function updateBulkBar() {
    const count = selected.size;
    if (count === 0 && !selectMode) { bulkBar.hidden = true; return; }
    bulkBar.hidden = false;
    bulkCountEl.textContent = `${count} selected`;
    bulkMoveBtn.disabled = count === 0;
    bulkDeleteBtn.disabled = count === 0;
  }

  bulkCloseBtn.addEventListener('click', () => setSelectMode(false));
  selectToggleBtn.addEventListener('click', () => setSelectMode(!selectMode));
  bulkSelectAll.addEventListener('click', () => {
    const allInputs = gallery.querySelectorAll<HTMLInputElement>('.select-input');
    const allSelected = images.length > 0 && images.every((i) => selected.has(i.id));
    allInputs.forEach((inp) => {
      const id = parseInt((inp.closest('.img-card') as HTMLElement).dataset.id ?? '0', 10);
      if (allSelected) { inp.checked = false; selected.delete(id); inp.closest('.img-card')!.classList.remove('selected'); }
      else { inp.checked = true; selected.add(id); inp.closest('.img-card')!.classList.add('selected'); }
    });
    if (!allSelected) setSelectMode(true);
    updateBulkBar();
  });

  bulkDeleteBtn.addEventListener('click', async () => {
    const ids = Array.from(selected);
    if (ids.length === 0) return;
    if (!confirm(`Delete ${ids.length} item${ids.length === 1 ? '' : 's'}? This cannot be undone.`)) return;
    bulkDeleteBtn.disabled = true;
    try {
      const res = await fetch('/api/images/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', ids }),
      });
      const json = await res.json() as { ok?: boolean; deleted?: number; error?: string };
      if (!json.ok) { alert(json.error ?? 'Bulk delete failed'); return; }
      // Remove cards + update local state
      let freed = 0;
      for (const id of ids) {
        const img = images.find((i) => i.id === id);
        if (img) freed += img.size;
      }
      images = images.filter((i) => !selected.has(i.id));
      selected.forEach((id) => {
        const card = gallery.querySelector(`.img-card[data-id="${id}"]`);
        card?.remove();
      });
      selected.clear();
      storageUsed = Math.max(storageUsed - freed, 0);
      updateStorageBar();
      updateCount();
      setSelectMode(false);
      if (images.length === 0) { gallery.hidden = true; galleryEmpty.hidden = false; }
      // Refresh folder counts
      refreshFolders();
    } catch {
      alert('Network error during bulk delete');
    } finally {
      bulkDeleteBtn.disabled = false;
    }
  });

  bulkMoveBtn.addEventListener('click', () => {
    const ids = Array.from(selected);
    if (ids.length === 0) return;
    openMoveModal(ids, null);
  });

  // ── Move modal ────────────────────────────────────────────────────────────
  function openMoveModal(ids: number[], currentFolderId: number | null) {
    moveModalTitle.textContent = ids.length > 1 ? `Move ${ids.length} items` : 'Move item';
    moveFolderList.innerHTML = '';

    const mk = (label: string, folderId: number | null, count?: number, disabled = false) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'folder-picker-item' + (disabled ? ' disabled' : '');
      b.disabled = disabled;
      b.innerHTML = `
        <span class="fp-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span>
        <span></span>
        ${count != null ? `<span class="fp-count">${count}</span>` : ''}
      `;
      (b.querySelectorAll('span')[1] as HTMLElement).textContent = label;
      if (!disabled) b.addEventListener('click', () => doMove(ids, folderId));
      return b;
    };

    moveFolderList.appendChild(mk('Root (no folder)', null, undefined, currentFolderId === null && ids.length === 1));
    for (const f of folders) {
      moveFolderList.appendChild(mk(f.name, f.id, f.count, currentFolderId === f.id && ids.length === 1));
    }
    if (folders.length === 0) {
      const hint = document.createElement('p');
      hint.className = 'app-modal-sub';
      hint.style.marginTop = '8px';
      hint.textContent = 'You have no folders yet. Create one first.';
      moveFolderList.appendChild(hint);
    }
    showModal(moveModal);
  }

  async function doMove(ids: number[], folderId: number | null) {
    try {
      const res = await fetch('/api/images/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'move', ids, folder_id: folderId }),
      });
      const json = await res.json() as { ok?: boolean; moved?: number; error?: string };
      if (!json.ok) { alert(json.error ?? 'Move failed'); return; }
      // Update local state: if current view is filtered, remove moved items
      if (typeof currentView === 'number' && currentView !== folderId) {
        images = images.filter((i) => !ids.includes(i.id));
        ids.forEach((id) => gallery.querySelector(`.img-card[data-id="${id}"]`)?.remove());
      } else if (currentView === 'root' && folderId !== null) {
        images = images.filter((i) => !ids.includes(i.id));
        ids.forEach((id) => gallery.querySelector(`.img-card[data-id="${id}"]`)?.remove());
      } else {
        // Update folderId on remaining cards in state
        images = images.map((i) => ids.includes(i.id) ? { ...i, folderId } : i);
      }
      selected.clear();
      setSelectMode(false);
      updateCount();
      if (images.length === 0) { gallery.hidden = true; galleryEmpty.hidden = false; }
      hideModal(moveModal);
      refreshFolders();
    } catch {
      alert('Network error during move');
    }
  }

  // ── New folder modal ─────────────────────────────────────────────────────
  newFolderBtn.addEventListener('click', () => {
    newFolderInput.value = '';
    newFolderError.hidden = true;
    showModal(newFolderModal);
    setTimeout(() => newFolderInput.focus(), 50);
  });
  newFolderInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') newFolderConfirm.click();
  });
  newFolderConfirm.addEventListener('click', async () => {
    const name = newFolderInput.value.trim();
    if (!name) { newFolderError.textContent = 'Please enter a folder name'; newFolderError.hidden = false; return; }
    newFolderConfirm.disabled = true;
    try {
      const res = await fetch('/api/folders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      const json = await res.json() as { ok?: boolean; folder?: FolderItem; error?: string };
      if (!json.ok || !json.folder) {
        newFolderError.textContent = json.error ?? 'Failed to create folder';
        newFolderError.hidden = false;
        return;
      }
      folders = [...folders, json.folder].sort((a, b) => a.name.localeCompare(b.name));
      renderFolders();
      hideModal(newFolderModal);
    } catch {
      newFolderError.textContent = 'Network error';
      newFolderError.hidden = false;
    } finally {
      newFolderConfirm.disabled = false;
    }
  });

  async function promptRenameFolder(f: FolderItem) {
    const name = prompt('Rename folder', f.name);
    if (name == null) return;
    const trimmed = name.trim();
    if (!trimmed || trimmed === f.name) return;
    try {
      const res = await fetch(`/api/folders/${f.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: trimmed }),
      });
      const json = await res.json() as { ok?: boolean; error?: string };
      if (!json.ok) { alert(json.error ?? 'Rename failed'); return; }
      folders = folders.map((x) => x.id === f.id ? { ...x, name: trimmed } : x)
                       .sort((a, b) => a.name.localeCompare(b.name));
      renderFolders();
      renderBreadcrumbs();
    } catch { alert('Network error'); }
  }

  let folderDelTarget: FolderItem | null = null;
  function openFolderDeleteModal(f: FolderItem) {
    folderDelTarget = f;
    folderDelSub.textContent = f.count > 0
      ? `"${f.name}" contains ${f.count} item${f.count === 1 ? '' : 's'}. What should happen to them?`
      : `Delete the empty folder "${f.name}"?`;
    folderDelMove.hidden = f.count === 0;
    folderDelPurge.textContent = f.count === 0 ? 'Delete folder' : 'Delete files too';
    showModal(folderDelModal);
  }
  async function deleteFolderRequest(mode: 'move' | 'purge') {
    if (!folderDelTarget) return;
    const f = folderDelTarget;
    folderDelMove.disabled = true; folderDelPurge.disabled = true;
    try {
      const res = await fetch(`/api/folders/${f.id}?mode=${mode}`, { method: 'DELETE' });
      const json = await res.json() as { ok?: boolean; purgedCount?: number; error?: string };
      if (!json.ok) { alert(json.error ?? 'Delete failed'); return; }
      folders = folders.filter((x) => x.id !== f.id);
      // If we were inside that folder, go back to All files
      if (currentView === f.id) { currentView = 'all'; }
      hideModal(folderDelModal);
      // Reload data for accurate storage/counts
      await loadImages(false);
    } catch { alert('Network error'); }
    finally { folderDelMove.disabled = false; folderDelPurge.disabled = false; }
  }
  folderDelMove.addEventListener('click', () => deleteFolderRequest('move'));
  folderDelPurge.addEventListener('click', () => deleteFolderRequest('purge'));

  async function refreshFolders() {
    try {
      const res = await fetch('/api/folders');
      const json = await res.json() as { ok?: boolean; folders?: FolderItem[] };
      if (json.ok && json.folders) {
        folders = json.folders;
        renderFolders();
        renderBreadcrumbs();
      }
    } catch {}
  }

  // ── Modal helpers ─────────────────────────────────────────────────────────
  function showModal(m: HTMLElement) {
    m.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function hideModal(m: HTMLElement) {
    m.hidden = true;
    document.body.style.overflow = '';
  }
  document.querySelectorAll('.app-modal').forEach((modal) => {
    modal.querySelectorAll('[data-close]').forEach((el) => {
      el.addEventListener('click', () => hideModal(modal as HTMLElement));
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('.app-modal').forEach((m) => { if (!m.hidden) hideModal(m); });
  });

  // Breadcrumb static buttons
  breadcrumbsEl.querySelectorAll<HTMLButtonElement>('.crumb').forEach((b) => {
    b.addEventListener('click', () => {
      const v = b.getAttribute('data-folder');
      navigateTo(v === 'all' ? 'all' : v === 'root' ? 'root' : 'all');
    });
  });

  // ── Sidebar (mobile drawer) ───────────────────────────────────────────────
  const appShell = document.getElementById('app-shell')!;
  const menuToggle = document.getElementById('menu-toggle');
  const sidebarClose = document.getElementById('sidebar-close');
  const sidebarScrim = document.getElementById('sidebar-scrim');
  function openSidebar()  { appShell.classList.add('menu-open'); }
  function closeSidebar() { appShell.classList.remove('menu-open'); }
  menuToggle?.addEventListener('click', openSidebar);
  sidebarClose?.addEventListener('click', closeSidebar);
  sidebarScrim?.addEventListener('click', closeSidebar);

  // Smooth-scroll side nav anchors
  document.querySelectorAll<HTMLAnchorElement>('.side-item[data-scrollto]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const id = a.getAttribute('data-scrollto');
      if (!id) return;
      const target = id === 'upload-card' ? document.getElementById('drop-zone')
                   : document.getElementById(id);
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      closeSidebar();
    });
  });

  // ── Files-count tile wiring ───────────────────────────────────────────────
  const filesCountEl = document.getElementById('stat-files-count');
  const foldersCountEl = document.getElementById('stat-folders-count');
  const statFilesFoot = document.getElementById('stat-files-foot');
  function updateFilesTile() {
    if (filesCountEl) filesCountEl.textContent = String(images.length);
    if (foldersCountEl) foldersCountEl.textContent = String(folders.length);
    if (statFilesFoot && folders.length === 0) {
      statFilesFoot.textContent = images.length === 0 ? 'Nothing uploaded yet' : 'in your library';
    } else if (statFilesFoot) {
      statFilesFoot.innerHTML = `across <span>${folders.length}</span> folder${folders.length === 1 ? '' : 's'}`;
    }
  }
  // Refresh files tile any time storage tile updates (i.e. after every fetch)
  if (storageText) {
    new MutationObserver(updateFilesTile).observe(storageText, { childList: true, characterData: true, subtree: true });
  }

  // ── Init ──────────────────────────────────────────────────────────────────
  loadImages();
  updateFilesTile();
</script>


</Layout>
