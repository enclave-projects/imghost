---
import { env } from 'cloudflare:workers';
import { getPaymentByOrderId, getUserById } from '../../lib/db';
import { PLANS, type PlanId } from '../../lib/plans';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=/profile');

const orderId = Astro.params.orderId ?? '';
const payment = env?.DB ? await getPaymentByOrderId(env.DB, orderId) : null;

// Guard: invoice must exist, belong to this user, and be PAID
if (!payment || payment.user_id !== user.id) {
  return new Response('Invoice not found', { status: 404 });
}
if (payment.status !== 'PAID') {
  return new Response('Invoice is not available for unpaid or failed orders', { status: 404 });
}

const dbUser = env?.DB ? await getUserById(env.DB, user.id) : null;
const plan = PLANS[payment.plan as PlanId];

// Human formatting
const fmtDate = (iso: string) =>
  new Date(iso + (iso.endsWith('Z') ? '' : 'Z')).toLocaleDateString('en-IN', {
    day: '2-digit', month: 'short', year: 'numeric',
  });
const fmtMoney = (n: number, ccy = 'INR') =>
  new Intl.NumberFormat('en-IN', { style: 'currency', currency: ccy, maximumFractionDigits: 2 }).format(n);

// GST split assumption (18% inclusive) — adjust if you have separate tax handling
const GST_RATE = 0.18;
const gross = Number(payment.amount);
const taxable = +(gross / (1 + GST_RATE)).toFixed(2);
const tax = +(gross - taxable).toFixed(2);

const invoiceNumber = `INV-${String(payment.id).padStart(6, '0')}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{invoiceNumber} · ImgHost Invoice</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600&family=Inter:wght@400;500;600;700&display=swap');
    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: #f5f5f5;
      color: #111;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      font-size: 14px; line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    .toolbar {
      position: sticky; top: 0; z-index: 10;
      background: #fff; border-bottom: 1px solid #e5e5e5;
      padding: 12px 20px;
      display: flex; justify-content: space-between; align-items: center; gap: 12px;
    }
    .toolbar-title { font-size: 13px; color: #666; }
    .toolbar-actions { display: flex; gap: 8px; }
    .btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 14px; border-radius: 100px;
      font-size: 13px; font-weight: 500; letter-spacing: -0.13px;
      border: 1px solid transparent; cursor: pointer;
      text-decoration: none;
      transition: background .15s, border-color .15s;
    }
    .btn-primary { background: #111; color: #fff; }
    .btn-primary:hover { background: #000; }
    .btn-ghost { background: transparent; color: #333; border-color: #d4d4d4; }
    .btn-ghost:hover { background: #f5f5f5; }

    .page {
      max-width: 800px; margin: 24px auto;
      background: #fff; padding: 56px 64px;
      border: 1px solid #e5e5e5; border-radius: 12px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.04);
    }
    @media (max-width: 720px) { .page { padding: 32px 24px; border-radius: 0; } }

    .head {
      display: flex; justify-content: space-between; gap: 24px;
      padding-bottom: 32px; border-bottom: 1px solid #e5e5e5;
      margin-bottom: 32px; flex-wrap: wrap;
    }
    .brand {
      display: flex; align-items: center; gap: 10px;
      font-family: 'Inter Tight', sans-serif;
      font-size: 20px; font-weight: 600; letter-spacing: -0.5px;
    }
    .logo-dot {
      width: 14px; height: 14px; border-radius: 50%;
      background: conic-gradient(from 210deg, #6a4cf5, #d44df0, #ff7a3d, #6a4cf5);
    }
    .doc-label {
      text-align: right;
      font-family: 'Inter Tight', sans-serif;
      font-size: 30px; font-weight: 500; letter-spacing: -0.03em;
      line-height: 1;
    }
    .doc-sub { font-size: 12px; color: #666; margin-top: 6px; letter-spacing: -0.12px; }

    .meta-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 32px; margin-bottom: 32px;
    }
    @media (max-width: 600px) { .meta-grid { grid-template-columns: 1fr; gap: 20px; } }
    .meta-block h3 {
      font-size: 11px; font-weight: 500; color: #888;
      letter-spacing: 0.1em; text-transform: uppercase;
      margin: 0 0 8px;
    }
    .meta-block p { margin: 0 0 2px; font-size: 14px; color: #111; }
    .meta-block p.muted { color: #666; font-size: 13px; }

    .info-rows {
      display: flex; flex-direction: column;
      border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5;
      margin-bottom: 32px;
    }
    .info-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 12px 0; border-bottom: 1px solid #f0f0f0;
      font-size: 13.5px;
    }
    .info-row:last-child { border-bottom: 0; }
    .info-row-key { color: #666; letter-spacing: -0.13px; }
    .info-row-val { color: #111; font-weight: 500; letter-spacing: -0.13px; }

    table.items {
      width: 100%; border-collapse: collapse;
      margin-bottom: 28px;
    }
    table.items thead th {
      text-align: left; padding: 10px 12px;
      background: #fafafa; border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5;
      font-size: 11px; font-weight: 500; color: #666;
      letter-spacing: 0.08em; text-transform: uppercase;
    }
    table.items thead th:last-child,
    table.items tbody td:last-child { text-align: right; }
    table.items tbody td {
      padding: 18px 12px;
      border-bottom: 1px solid #f0f0f0;
      vertical-align: top;
    }
    .item-name {
      font-family: 'Inter Tight', sans-serif;
      font-size: 16px; font-weight: 500; letter-spacing: -0.02em;
    }
    .item-desc { font-size: 12.5px; color: #666; margin-top: 2px; letter-spacing: -0.13px; }

    .totals {
      margin-left: auto;
      width: 100%; max-width: 320px;
      display: flex; flex-direction: column; gap: 6px;
      margin-bottom: 32px;
    }
    .totals-row {
      display: flex; justify-content: space-between;
      font-size: 13.5px;
    }
    .totals-row-key { color: #666; }
    .totals-row-val { color: #111; font-weight: 500; }
    .totals-total {
      display: flex; justify-content: space-between;
      align-items: baseline;
      padding-top: 12px; margin-top: 8px;
      border-top: 1px solid #e5e5e5;
    }
    .totals-total .key {
      font-size: 12px; font-weight: 500; color: #666;
      letter-spacing: 0.08em; text-transform: uppercase;
    }
    .totals-total .val {
      font-family: 'Inter Tight', sans-serif;
      font-size: 26px; font-weight: 500; letter-spacing: -0.03em;
    }

    .status-pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px; border-radius: 100px;
      font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase;
      background: #dcfce7; color: #15803d;
    }
    .status-pill::before {
      content: ''; width: 6px; height: 6px; border-radius: 50%;
      background: currentColor;
    }

    .foot {
      padding-top: 28px; border-top: 1px solid #e5e5e5;
      font-size: 12px; color: #666; line-height: 1.6;
    }
    .foot p { margin: 0 0 6px; }
    .foot a { color: #111; }

    /* Print styles */
    @media print {
      body { background: #fff; }
      .toolbar { display: none !important; }
      .page {
        margin: 0; padding: 24px 0;
        border: 0; border-radius: 0; box-shadow: none;
        max-width: none;
      }
      @page { size: A4; margin: 14mm 16mm; }
    }
  </style>
</head>
<body>

  <!-- Non-printable toolbar -->
  <div class="toolbar">
    <span class="toolbar-title">Invoice {invoiceNumber}</span>
    <div class="toolbar-actions">
      <a href="/profile" class="btn btn-ghost">← Back to profile</a>
      <button class="btn btn-primary" onclick="window.print()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Download / Print
      </button>
    </div>
  </div>

  <article class="page" id="invoice">

    <!-- Header -->
    <div class="head">
      <div>
        <div class="brand">
          <span class="logo-dot"></span>
          ImgHost
        </div>
        <p style="font-size:12.5px;color:#666;margin-top:10px;line-height:1.5;">
          ImgHost by Enclave Projects<br/>
          support@enclaveprojects.com
        </p>
      </div>
      <div>
        <div class="doc-label">Invoice</div>
        <div class="doc-sub">{invoiceNumber}</div>
        <div style="margin-top:12px;"><span class="status-pill">Paid</span></div>
      </div>
    </div>

    <!-- Billed to / dates -->
    <div class="meta-grid">
      <div class="meta-block">
        <h3>Billed to</h3>
        <p>{dbUser?.email ?? user.email}</p>
        <p class="muted">Customer ID: user_{user.id}</p>
      </div>
      <div class="meta-block" style="text-align:right;">
        <h3>Issued on</h3>
        <p>{fmtDate(payment.created_at)}</p>
      </div>
    </div>

    <!-- Order info -->
    <div class="info-rows">
      <div class="info-row">
        <span class="info-row-key">Order ID</span>
        <span class="info-row-val" style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px;">{payment.order_id}</span>
      </div>
      {payment.cf_payment_id && (
        <div class="info-row">
          <span class="info-row-key">Cashfree payment ID</span>
          <span class="info-row-val" style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px;">{payment.cf_payment_id}</span>
        </div>
      )}
      <div class="info-row">
        <span class="info-row-key">Payment method</span>
        <span class="info-row-val">Cashfree Payments</span>
      </div>
    </div>

    <!-- Line items -->
    <table class="items">
      <thead>
        <tr>
          <th>Description</th>
          <th>Qty</th>
          <th>Amount</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <div class="item-name">ImgHost {plan?.name ?? payment.plan} plan</div>
            <div class="item-desc">One-time plan activation. Storage, quota, and feature limits as per plan tier at time of purchase.</div>
          </td>
          <td>1</td>
          <td>{fmtMoney(taxable, payment.currency)}</td>
        </tr>
      </tbody>
    </table>

    <!-- Totals -->
    <div class="totals">
      <div class="totals-row">
        <span class="totals-row-key">Subtotal</span>
        <span class="totals-row-val">{fmtMoney(taxable, payment.currency)}</span>
      </div>
      <div class="totals-row">
        <span class="totals-row-key">GST (18%, inclusive)</span>
        <span class="totals-row-val">{fmtMoney(tax, payment.currency)}</span>
      </div>
      <div class="totals-total">
        <span class="key">Total paid</span>
        <span class="val">{fmtMoney(gross, payment.currency)}</span>
      </div>
    </div>

    <!-- Footer -->
    <div class="foot">
      <p><strong>Thank you for your purchase.</strong> This invoice is generated electronically and is valid without a signature.</p>
      <p>Questions about this charge? Email <a href="mailto:support@enclaveprojects.com">support@enclaveprojects.com</a> with your Order ID and we'll get back within 24 hours.</p>
      <p style="margin-top:12px;">Tax computed on an inclusive basis. This document is a tax invoice under applicable GST rules.</p>
    </div>

  </article>

</body>
</html>
