---
import Layout from '../layouts/Layout.astro';
export const prerender = false;
---
<Layout title="Sign In">
  <div class="auth-wrap">
    <!-- Left panel — gradient spotlight -->
    <aside class="auth-panel">
      <div class="panel-inner">
        <a href="/" class="logo">
          <span class="logo-dot"></span>
          ImgHost
        </a>
        <div class="panel-content">
          <span class="panel-eyebrow">Secure by design</span>
          <h2>Your images.<br/>Your account.<br/>Nobody else's.</h2>
          <p>Sessions ride on HTTP-only JWTs. Passwords are hashed with PBKDF2. Every query is scoped to your user.</p>
          <ul class="feature-list">
            <li><span class="feat-dot"></span>HS256 JWT sessions</li>
            <li><span class="feat-dot"></span>PBKDF2-SHA256 password hashing</li>
            <li><span class="feat-dot"></span>Private R2 objects by default</li>
          </ul>
        </div>
        <div class="panel-foot">Built on Cloudflare Workers · R2 · D1</div>
      </div>
    </aside>

    <!-- Right form -->
    <main class="auth-form-wrap">
      <div class="auth-form">
        <a href="/" class="mobile-logo">
          <span class="logo-dot"></span>
          ImgHost
        </a>
        <a href="/" class="back-link">← Back to home</a>
        <h1>Welcome<br/>back.</h1>
        <p class="sub">Sign in to your ImgHost account.</p>

        <div id="error" class="alert"></div>

        <form id="form">
          <div class="field">
            <label class="label" for="email">Email address</label>
            <input id="email" type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
          </div>
          <div class="field">
            <label class="label" for="password">Password</label>
            <input id="password" type="password" name="password" autocomplete="current-password" required placeholder="••••••••" />
          </div>
          <button type="submit" class="btn btn-primary submit-btn" id="submit">
            Sign in
            <svg id="submit-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>

        <div class="divider"><span>New to ImgHost?</span></div>
        <a href="/signup" class="btn btn-outline switch-btn">Create a free account</a>
      </div>
    </main>
  </div>

  <style>
    .auth-wrap {
      min-height: 100vh;
      display: flex;
      background: var(--canvas);
    }

    /* Left panel — gradient spotlight (Framer signature) */
    .auth-panel {
      display: none;
      width: 480px;
      flex-shrink: 0;
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg, #4a2bc9 0%, var(--g-violet) 45%, #a028c4 80%, var(--g-magenta) 100%);
    }
    @media (min-width: 960px) { .auth-panel { display: flex; } }

    .auth-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(120% 80% at 20% 10%, rgba(255,255,255,.22), transparent 55%);
      pointer-events: none;
    }
    .auth-panel::after {
      content: '';
      position: absolute; inset: auto -80px -80px auto;
      width: 360px; height: 360px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,122,61,.4), transparent 65%);
      filter: blur(20px);
      pointer-events: none;
    }

    .panel-inner {
      position: relative; z-index: 1;
      padding: 48px;
      display: flex; flex-direction: column;
      height: 100%; color: #fff;
    }

    .logo {
      display: inline-flex; align-items: center; gap: 10px;
      color: #fff; font-family: var(--font-display);
      font-weight: 600; font-size: 17px;
      letter-spacing: -0.4px; text-decoration: none;
    }
    .logo-dot {
      width: 14px; height: 14px; border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 20px rgba(255,255,255,.6);
    }

    .panel-content {
      margin-top: auto; margin-bottom: auto; padding-top: 48px;
      display: flex; flex-direction: column; gap: 24px;
    }
    .panel-eyebrow {
      align-self: flex-start;
      font-size: 12px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase;
      padding: 7px 11px; border-radius: 100px;
      background: rgba(0,0,0,.25); backdrop-filter: blur(8px);
    }
    .panel-content h2 {
      font-family: var(--font-display);
      font-size: clamp(34px, 4vw, 52px); font-weight: 500;
      color: #fff; letter-spacing: -0.04em; line-height: 1.0;
    }
    .panel-content p { color: rgba(255,255,255,.85); font-size: 16px; line-height: 1.4; letter-spacing: -0.16px; max-width: 380px; }

    .feature-list {
      list-style: none; display: flex; flex-direction: column; gap: 12px;
      margin-top: 12px;
    }
    .feature-list li {
      display: flex; align-items: center; gap: 12px;
      color: rgba(255,255,255,.95); font-size: 14px; font-weight: 500; letter-spacing: -0.14px;
    }
    .feat-dot {
      width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0;
      background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.3);
      position: relative;
    }
    .feat-dot::after {
      content: ''; position: absolute; left: 5px; top: 3px;
      width: 4px; height: 8px; border: solid #fff;
      border-width: 0 2px 2px 0; transform: rotate(45deg);
    }

    .panel-foot { margin-top: auto; padding-top: 32px; font-size: 12px; color: rgba(255,255,255,.7); letter-spacing: -0.12px; }

    /* Right form */
    .auth-form-wrap {
      flex: 1;
      display: flex; align-items: center; justify-content: center;
      padding: 40px 24px;
      background: var(--canvas);
      position: relative;
    }
    .auth-form-wrap::before {
      content: ''; position: absolute; pointer-events: none;
      top: -120px; left: -120px; width: 400px; height: 400px; border-radius: 50%;
      background: radial-gradient(circle, rgba(106,76,245,.15), transparent 60%);
      filter: blur(80px);
    }

    .auth-form {
      width: 100%; max-width: 420px;
      position: relative; z-index: 1;
    }

    .mobile-logo {
      display: flex; align-items: center; gap: 10px; margin-bottom: 32px;
      font-family: var(--font-display); font-weight: 600; font-size: 17px;
      letter-spacing: -0.4px; color: var(--text);
    }
    .mobile-logo .logo-dot {
      background: conic-gradient(from 210deg, var(--g-violet), var(--g-magenta), var(--g-orange), var(--g-violet));
      box-shadow: 0 0 20px rgba(212,77,240,.35);
    }
    @media (min-width: 960px) { .mobile-logo { display: none; } }

    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; color: var(--text-muted);
      margin-bottom: 24px;
      transition: color .15s;
    }
    .back-link:hover { color: var(--text); }

    h1 {
      font-family: var(--font-display);
      font-size: clamp(32px, 4vw, 48px); font-weight: 500;
      letter-spacing: -0.04em; line-height: 1.02;
      color: var(--text); margin-bottom: 10px;
    }
    .sub { font-size: 16px; color: var(--text-muted); margin-bottom: 32px; letter-spacing: -0.16px; }

    .submit-btn {
      width: 100%;
      padding: 14px;
      font-size: 15px;
      margin-top: 8px;
    }

    .divider {
      display: flex; align-items: center; gap: 12px;
      margin: 28px 0 14px;
      color: var(--text-faint); font-size: 13px; letter-spacing: -0.13px;
    }
    .divider::before, .divider::after {
      content: ''; flex: 1; height: 1px; background: var(--border);
    }

    .switch-btn { width: 100%; padding: 13px; font-size: 14px; }
  </style>

  <script>
    const form = document.getElementById('form') as HTMLFormElement;
    const errorEl = document.getElementById('error')!;
    const submitBtn = document.getElementById('submit') as HTMLButtonElement;
    const arrow = document.getElementById('submit-arrow')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.className = 'alert';
      errorEl.textContent = '';
      submitBtn.disabled = true;
      arrow.hidden = true;
      submitBtn.innerHTML = '<span class="spinner" style="width:16px;height:16px;border-width:2px"></span> Signing in…';

      const data = new FormData(form);
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: data.get('email'), password: data.get('password') }),
        });
        const json = await res.json() as { ok?: boolean; error?: string };
        if (json.ok) {
          window.location.href = '/dashboard';
        } else {
          errorEl.className = 'alert alert-error';
          errorEl.textContent = json.error ?? 'Login failed';
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'Sign in <svg id="submit-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
        }
      } catch {
        errorEl.className = 'alert alert-error';
        errorEl.textContent = 'Network error. Please try again.';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Sign in →';
      }
    });
  </script>
</Layout>
