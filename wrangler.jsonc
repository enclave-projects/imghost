{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "imghost",
	"pages_build_output_dir": "./dist",
	"compatibility_date": "2026-05-05",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "imghost-images"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "imghost-db",
			"database_id": "a2f7914a-08f9-4bf6-ad4c-5a9b58eebfb2",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "e0c3697f78134a0fb6b7f90a738d3e2d"
		}
	],
	"observability": {
		"enabled": true
	}
}